	0% {
		background: rgba(255, 208, 0, 0.62);
		box-shadow: 0 0 0 3px rgba(255, 208, 0, 0.45);
	}
	100% {
		background: rgba(255, 208, 0, 0.22);
		box-shadow: 0 0 0 0 transparent;
	}
