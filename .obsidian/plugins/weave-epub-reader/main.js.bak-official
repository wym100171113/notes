	cursor: pointer;
}
body .weave-epub-vocab-term--new {
	background: rgba(220, 120, 60, 0.2);
	text-decoration-color: rgba(220, 120, 60, 0.85);
}
body .weave-epub-vocab-term--learning {
	background: rgba(80, 140, 220, 0.16);
	text-decoration-color: rgba(80, 140, 220, 0.8);
}
body .weave-epub-vocab-term--mature {
	background: rgba(90, 160, 110, 0.12);
	text-decoration-color: rgba(90, 160, 110, 0.65);
}
body .weave-epub-vocab-term--due {
	background: rgba(180, 70, 120, 0.18);
	text-decoration-color: rgba(180, 70, 120, 0.85);
}
body .weave-epub-vocab-locate,
body mark.weave-epub-vocab-locate {
	background: rgba(255, 208, 0, 0.42) !important;
	box-shadow: 0 0 0 2px rgba(255, 208, 0, 0.35);
	border-radius: 2px;
	color: inherit;
	animation: weave-epub-vocab-locate-pulse 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}
