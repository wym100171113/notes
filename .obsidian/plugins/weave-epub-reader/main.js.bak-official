re(){return o()},set onCapture(w){o(w),$()},get onCancel(){return s()},set onCancel(w){s(w),$()},$set:$r,$on:(w,x)=>Hr(e,w,x)},T=Wt(),P=St(T);{var S=w=>{var x=Jve();let F;x.__mousedown=[Wve,g],x.__mousemove=[jve,v],x.__mouseup=[qve,m],x.__touchstart=[Kve,g],x.__touchmove=[Gve,v],x.__touchend=[Zve,m],x.__keydown=[Xve];var L=C(x);{var B=A=>{var N=Yve();le(()=>Da(N,`left: ${l(f).x??""}px; top: ${l(f).y??""}px; width: ${l(f).width??""}px; height: ${l(f).height??""}px;`)),H(A,N)};de(L,A=>{l(f).width>0&&l(f).height>0&&A(B)})}k(x),wi(x,A=>R(c,A),()=>l(c)),le(A=>F=Vt(x,1,"epub-screenshot-overlay svelte-1nbw487",null,F,A),[()=>({"is-hidden":l(d)})]),Fc("wheel",x,y),H(w,x)};de(P,w=>{t()&&w(S)})}return H(r,T),Or(_)}ki(["mousedown","mousemove","mouseup","touchstart","touchmove","touchend","keydown"]);const Qve=[{title:"打开与恢复",paragraphs:["把书籍文件放进 Obsidian 仓库后，点击文件即可打开。阅读器会自动保存并恢复阅读进度、常用排版设置与当前阅读状态。","当前支持 .epub、.mobi、.azw3、.fb2、.fbz、.txt、.cbz。通常 EPUB、FB2/FBZ、TXT 更适合结构化导出，CBZ 更偏图片阅读。"]},{title:"侧边栏与书架",paragraphs:["阅读器支持局部侧边栏与全局书架视图，适合在同一套笔记环境中快速切换书籍、目录和标注。"],listGroups:[{items:["目录：按章节快速跳转。","笔记：查看当前书籍已回显的高亮、想法与相关内容。","书签：管理当前页书签。","我的书架：浏览仓库中的书籍文件，并从我的书架子视图返回当前书籍侧边栏。"]}]},{title:"阅读模式与版式",listGroups:[{heading:"阅读流",items:["翻页模式：适合线性阅读与键盘翻页。","连续滚动：适合长段浏览、脚注往返与快速搜索上下文。"]},{heading:"页面布局",items:["单页：默认布局，适合绝大多数场景。","双栏：更接近摊开书本的阅读感，开启后会自动使用宽版显示。"]},{heading:"宽度模式",items:["standard：标准阅读宽度，适合长文沉浸阅读。","full：宽版阅读宽度，在大屏上保留舒适留白。","edge：真正全宽模式，尽量使用宿主可用宽度显示内容。"]}]},{title:"显示设置与辅助",paragraphs:["阅读器设置不只包含宽度，还覆盖排版、脚注与顶部信息展示，适合按书籍类型微调。"],listGroups:[{items:["排版面板支持调节行高、字间距、页边距，并可恢复默认值。","连续滚动模式可单独开关右侧侧边翻页键。","点击脚注序号可在“显示脚注浮窗”和“直接跳转脚注位置”之间切换。"]}]}],eye=[{title:"标注样式",paragraphs:["选中文本后会弹出工具栏，支持颜色高亮与多种线性标注样式。颜色、样式与定位信息会一起保存并回显。"],colors:[{tone:"yellow",label:"黄色",description:"常规标记"},{tone:"green",label:"绿色",description:"重点内容"},{tone:"blue",label:"蓝色",description:"思考笔记"},{tone:"red",label:"红色",description:"疑问标记"},{tone:"purple",label:"紫色",description:"延伸联想"}],listGroups:[{heading:"样式",items:["高亮：适合普通摘录。","下划线：适合保留正文背景、强调关键句。","删除线：适合标记应忽略、修订或待屏蔽内容。","波浪线：适合问题点、疑问点或需要再次推敲的位置。"]}]},{title:"想法气泡与脚注浮窗",paragraphs:["正文中的想法气泡只是额外提示，不会替代或削弱高亮、下划线、删除线、波浪线本身。","只要摘录内容里存在 ---div--- 分隔区，阅读器就会在正文高亮旁显示想法气泡。点击气泡或高亮工具条中的“想法”都可以编辑内容。","脚注序号点击行为可按你的习惯配置为“显示脚注浮窗”或“直接跳转到脚注位置”。"]},{title:"回显与同步",listGroups:[{items:["高亮、样式、想法会在重新打开同一本书时自动回显。","数据来源统一支持 Markdown、Canvas 与卡片数据，不依赖单独的黑盒数据库。","溯源链接是回显与定位的权威信息，只要不破坏定位链接，就可以自由改写摘录正文。","笔记文件更新后，阅读器会重新加载相关高亮，保持正文和笔记侧一致。"]}]}],tye=[{title:"自动化摘录说明",paragraphs:["在阅读器中，仅选中文本并高亮只会短暂显示，并不会保存摘录数据。要永久保存，你需要新建或选择一个 Markdown 笔记、Canvas，或摘录到 Weave，并选择摘录插入位置，之后才会自动写入指定位置。","许多用户容易误解，以为选中文本高亮就等于自动保存笔记。实际上必须经过「新建或选择目标文件」这一步，摘录才会写入仓库并长期保留。"],listGroups:[{heading:"摘录保存与汇总",items:["阅读摘录笔记保存在 Markdown、Canvas 与 Weave 卡片中，阅读器通过汇总统一显示。","你可以自由编辑卡片正文内容，但不要修改溯源链接，否则会破坏定位与回显。","要永久保存摘录，请通过选中工具栏选择目标：新建或选择 Markdown、绑定 Canvas，或摘录到 Weave。"]}]},{title:"自动模式与选中工具栏",paragraphs:["自动模式决定选中文本后的默认输出方式：关闭时更偏“复制”，开启时更偏“直接写入当前工作流”。"],listGroups:[{items:["自动模式关闭：复制到剪贴板，适合临时引用。","自动模式开启：更适合直接写入当前工作流；在已绑定 Canvas 的场景下，也会参与联动流程。","选中工具栏支持复制或插入、搜索、制卡、阅读点、AI 等操作。"]}]},{title:"摘录格式与定位链接",paragraphs:["阅读器会尽量为摘录附带精确定位信息，让你可以从笔记反跳回原文位置。","如果摘录包含想法，推荐把想法写在 ---div--- 分隔区之后，后续会自动在正文显示想法气泡。"],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> 摘录正文
> ---div---
> 想法正文`},{title:"书签与阅读位置",paragraphs:["每本书对应库内一份专有 Markdown（默认 Weave EPUB Reader/data_{书名}.md），阅读进度与书签列表写入该文件 YAML，随 Vault 全平台同步。"],listGroups:[{items:["当前页书签：写入专有 MD 的 bookmarks 列表，在侧栏书签页管理。","阅读进度：写入专有 MD 的 readingState，连续阅读与关闭阅读器时自动保存，打开书籍时自动恢复。","参考阅读位置：高级功能，记录在插件本地状态，通常不随库同步。"]}]}],rye=[{title:"导出为 Markdown",paragraphs:["导出入口以阅读器视图菜单为准，适合把内容沉淀回仓库中的长期笔记。"],listGroups:[{items:["导出当前章节：把当前章转成 Markdown，并尽量把图片写成 Obsidian 友好的附件引用。","导出本书高亮摘录：整理当前书籍的标注与摘录，便于后续再加工。"]}]},{title:"截图与 Canvas 联动",listGroups:[{heading:"截图",items:["截图模式下可在阅读区域拖拽截图。","图片模式：保存为图片文件；自动模式开启时可直接插入。","嵌入模式：尽量提取文字并生成带定位的引用；自动模式关闭时会优先复制结果。"]},{heading:"Canvas",items:["可以为当前书创建新的 Canvas 脑图，也可以绑定已有 Canvas。","绑定后可打开、继续编辑或断开联动，适合做章节结构图、问题树和阅读路线。"]}]},{title:"常用入口与快捷键",shortcuts:[{keys:["←","→"],description:"翻页模式且 EPUB 视图获得焦点时切换前后页（连续滚动模式不占用方向键）。"},{keys:["←","→","PageUp","PageDown"],description:"段落阅读模式下面板获得焦点时，在段内或相邻段落间移动。"},{keys:["Esc"],description:"关闭当前教程，或在已聚焦的阅读器弹层上退出当前层。"}],buttons:[{icon:"list",label:"侧边栏",description:"切换目录、笔记、书签与书架相关入口。"},{icon:"a-large-small",label:"排版设置",description:"调整行高、字间距、页边距等阅读参数。"},{icon:"arrow-up-down",label:"阅读流",description:"在翻页与连续滚动之间切换。"},{icon:"scroll-text",label:"页面布局",description:"在单页与双栏布局之间切换。"},{icon:"bookmark",label:"当前页书签",description:"记录当前页位。"},{icon:"flag",label:"参考阅读位置",description:"保存或更新参考阅读锚点。"},{icon:"layout-dashboard",label:"Canvas 脑图",description:"创建、绑定或管理阅读脑图。"},{icon:"camera",label:"截图工具",description:"进入截图工作流。"},{icon:"zap",label:"自动模式",description:"切换复制型输出与自动插入型输出。"},{icon:"circle-help",label:"使用教程",description:"再次打开本教程。"}]}],iye=[{title:"Weave 是什么",paragraphs:["Weave 是一组面向 Obsidian 的知识工作流插件，围绕「读 → 记 → 排 → 复习」组织长期学习。","Weave EPUB Reader（本插件）负责在库内读书与摘录；Weave 主插件负责记忆牌组、题库与智能制卡；Weave Incremental Reading 负责增量阅读队列与日历排期。"],listGroups:[{heading:"三者分工",items:["Weave EPUB Reader：在 Obsidian 内阅读书籍，管理摘录与高亮，并与笔记、Canvas、牌组联动。","Weave 主插件：从 Obsidian 任意文件的段落摘录生成带溯源链接的记忆卡片，并以表格、看板、网格等视图管理与复习。","Weave Incremental Reading：把「以后再看」的内容整理成阅读点队列，用专题与月历调度多书、多章节的推进节奏。"]}]},{title:"Weave EPUB Reader（当前插件）",paragraphs:["让 Obsidian 不只是笔记仓库，也是你正经读书的地方：在 Vault 内打开 EPUB、TXT 等书籍，边读边摘录，并通过深链接与正文回显，把「书里的句子」和「库里的笔记」连在一起。"],listGroups:[{heading:"核心功能",items:["书架与阅读：多格式书籍管理、目录跳转、翻页/滚动、版式与主题、阅读进度与书签。","摘录与高亮：选区工具栏、五种高亮色与多种线性标注、想法气泡、自动或手动写入 Markdown / Canvas / Weave 牌组。","溯源与回显：摘录保留定位信息；笔记侧修改后，书中高亮同步更新；可从高亮反查来源笔记、Canvas 或牌组。","扩展工作流：章节导出、截图、Canvas 绑定、段落阅读模式；与 Weave 主插件衔接制卡与 AI，与增量阅读插件衔接章节排期与阅读点。","以及更多"]}]},{title:"Weave 主插件",paragraphs:["Weave 是基于 Obsidian 的知识卡片系统：从库内任意文件的任意段落摘录，生成带有溯源链接的记忆卡片；所有卡片都可保留溯源定位信息，便于随时跳回原文。","你可以用表格视图、看板视图、网格卡片视图浏览和管理 Weave 中的全部卡片与牌组。"],listGroups:[{heading:"核心功能",items:["摘录制卡：从 Markdown、PDF、EPUB 阅读器、Canvas 等任意来源的段落或选区创建记忆卡片，并附带回到原文的溯源链接。","多视图管理：以表格视图、看板视图、网格卡片视图浏览、筛选、组织全部卡片与牌组。","侧边栏网格视图：将网格卡片视图移入 Obsidian 侧边栏后，可关联当前活动的 Markdown 文档，只显示与该文档相关的卡片；并支持基于当前文档进行 AI 制卡、解析并导入卡片。","题库与练习：解析题库 Markdown 文档，导入题目并开始习题测试；支持错题本与考试统计。","间隔复习：FSRS 调度算法、学习会话、进度统计与牌组管理。","以及更多"]}]},{title:"Weave Incremental Reading（增量阅读插件）",paragraphs:["解决「收藏很多、同时开很多本书却都读不深」的问题：把 Markdown、PDF 选区、Canvas、网页、EPUB 章节等零散材料，整理成可排期、可续读、可回跳的阅读点队列，用月历推进而不是靠意志力硬啃。"],listGroups:[{heading:"核心功能",items:["阅读点与专题（IRDeck）：从文档选区、块链接、阅读器选中文本等创建阅读点，归入 .irdeck 专题。","增量阅读月历：按日期查看待处理、已排期与逾期的阅读点，安排每日阅读任务。","调度与续读：支持每日上限、时间预算、交错阅读等策略；标记续读点后，可一键回到原文位置继续。","来源回跳：阅读点保留来源信息，从队列跳回 Markdown、PDF、EPUB 等原始位置。","与阅读器联动：在本阅读器目录中可将章节「添加到增量阅读」；选中文本可创建带 EPUB 溯源链接的增量阅读点。","以及更多"]}]},{title:"怎么组合使用",paragraphs:["三款插件职责分离、可按需组合，常见用法如下："],listGroups:[{items:["只想在 Obsidian 里读书、做摘录：只装 Weave EPUB Reader 即可。","读完要复习、要制卡：EPUB Reader + Weave 主插件；摘录后可一键填充到制卡窗口，或 AI 拆分制卡。","多本书/长书要有节奏：EPUB Reader + Weave Incremental Reading；章节进月历排期，到调度日再深链接回书中精读。","完整闭环（读 → 记 → 排 → 复习）：三款都装；读书摘录 → 制卡复习 → 章节/段落进增量队列，长期推进。"]}]}],aye=[{title:"EPUB 解析与阅读内核",paragraphs:["EPUB 文件阅读现已完全基于 foliate-js 内核，历史阅读定位与已有数据会尽量兼容迁移。"]},{title:"链接与知识沉淀",paragraphs:["EPUB 精确链接与回跳工作流参考了 Obsidian PDF++ 的优秀思路，同时结合了 Obsidian 的双向链接与图谱能力。"]},{title:"阅读与 Canvas 联动",paragraphs:["EPUB 阅读器与 Obsidian Canvas 的联动体验参考了 MarginNote 的阅读与脑图工作流，并继续沿着 Obsidian 原生文件体系演进。"]},{title:"段落阅读设计参考",paragraphs:["段落阅读模式的设计思路参考了 Readest 阅读软件的段落模式体验，并结合 EPUB 阅读器自身的定位、摘录与脚注工作流做了适配。"]},{title:"工具条设计参考",paragraphs:["选中文本后的工具条交互设计参考了微信读书的工具条体验。"]},{title:"词典插件兼容致谢",paragraphs:["感谢群友为 Obsidian 开发的词典插件 obsdian-fingertip-translation。该插件原本支持 Obsidian Markdown 编辑界面的划词词典体验，经过兼容性处理后，也可以在本 EPUB 阅读器中正常使用。","阅读器自身不内置词典功能，相关词典解释与弹窗能力由该外部插件提供。"],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],nye={basics:Qve,highlight:eye,workflow:tye,tools:rye,family:iye,credits:aye},oye=[{title:"開啟與恢復",paragraphs:["把書籍檔案放進 Obsidian 倉庫後，點選檔案即可開啟。閱讀器會自動儲存並恢復閱讀進度、常用排版設定與當前閱讀狀態。","當前支援 .epub、.mobi、.azw3、.fb2、.fbz、.txt、.cbz。通常 EPUB、FB2/FBZ、TXT 更適合結構化匯出，CBZ 更偏圖片閱讀。"]},{title:"側邊欄與書架",paragraphs:["閱讀器支援區域性側邊欄與全域性書架檢視，適合在同一套筆記環境中快速切換書籍、目錄和標註。"],listGroups:[{items:["目錄：按章節快速跳轉。","筆記：檢視當前書籍已回顯的高亮、想法與相關內容。","書籤：管理當前頁書籤。","我的書架：瀏覽倉庫中的書籍檔案，並從我的書架子檢視返回當前書籍側邊欄。"]}]},{title:"閱讀模式與版式",listGroups:[{heading:"閱讀流",items:["翻頁模式：適合線性閱讀與鍵盤翻頁。","連續滾動：適合長段瀏覽、腳註往返與快速搜尋上下文。"]},{heading:"頁面佈局",items:["單頁：預設佈局，適合絕大多數場景。","雙欄：更接近攤開書本的閱讀感，開啟後會自動使用寬版顯示。"]},{heading:"寬度模式",items:["standard：標準閱讀寬度，適合長文沉浸閱讀。","full：寬版閱讀寬度，在大屏上保留舒適留白。","edge：真正全寬模式，儘量使用宿主可用寬度顯示內容。"]}]},{title:"顯示設定與輔助",paragraphs:["閱讀器設定不只包含寬度，還覆蓋排版、腳註與頂部資訊展示，適合按書籍型別微調。"],listGroups:[{items:["排版面板支援調節行高、字間距、頁邊距，並可恢復預設值。","連續滾動模式可單獨開關右側側邊翻頁鍵。","頂部貼紙支援自動、所在行顯示、右側單列三種佈局。","點選腳註序號可在“顯示腳註浮窗”和“直接跳轉腳註位置”之間切換。"]}]}],sye=[{title:"標註樣式",paragraphs:["選中文字後會彈出工具欄，支援顏色高亮與多種線性標註樣式。顏色、樣式與定位資訊會一起儲存並回顯。"],colors:[{tone:"yellow",label:"黃色",description:"常規標記"},{tone:"green",label:"綠色",description:"重點內容"},{tone:"blue",label:"藍色",description:"思考筆記"},{tone:"red",label:"紅色",description:"疑問標記"},{tone:"purple",label:"紫色",description:"延伸聯想"}],listGroups:[{heading:"樣式",items:["高亮：適合普通摘錄。","下劃線：適合保留正文背景、強調關鍵句。","刪除線：適合標記應忽略、修訂或待遮蔽內容。","波浪線：適合問題點、疑問點或需要再次推敲的位置。"]}]},{title:"想法氣泡與腳註浮窗",paragraphs:["正文中的想法氣泡只是額外提示，不會替代或削弱高亮、下劃線、刪除線、波浪線本身。","只要摘錄內容裡存在 ---div--- 分隔區，閱讀器就會在正文高亮旁顯示想法氣泡。點選氣泡或高亮工具條中的“想法”都可以編輯內容。","腳註序號點選行為可按你的習慣配置為“顯示腳註浮窗”或“直接跳轉到腳註位置”。"]},{title:"回顯與同步",listGroups:[{items:["高亮、樣式、想法會在重新開啟同一本書時自動回顯。","資料來源統一支援 Markdown、Canvas 與卡片資料，不依賴單獨的黑盒資料庫。","溯源連結是回顯與定位的權威資訊，只要不破壞定位連結，就可以自由改寫摘錄正文。","筆記檔案更新後，閱讀器會重新載入相關高亮，保持正文和筆記側一致。"]}]}],lye=[{title:"自動化摘錄說明",paragraphs:["在閱讀器中，僅選中文字並高亮只會短暫顯示，並不會儲存摘錄資料。要永久儲存，你需要新建或選擇一個 Markdown 筆記、Canvas，或摘錄到 Weave，並選擇摘錄插入位置，之後才會自動寫入指定位置。","許多使用者容易誤解，以為選中文字高亮就等於自動儲存筆記。實際上必須經過「新建或選擇目標檔案」這一步，摘錄才會寫入倉庫並長期保留。"],listGroups:[{heading:"摘錄儲存與彙總",items:["閱讀摘錄筆記儲存在 Markdown、Canvas 與 Weave 卡片中，閱讀器透過彙總統一顯示。","你可以自由編輯卡片正文內容，但不要修改溯源連結，否則會破壞定位與回顯。","要永久儲存摘錄，請透過選中工具欄選擇目標：新建或選擇 Markdown、繫結 Canvas，或摘錄到 Weave。"]}]},{title:"自動模式與選中工具欄",paragraphs:["自動模式決定選中文字後的預設輸出方式：關閉時更偏“複製”，開啟時更偏“直接寫入當前工作流”。"],listGroups:[{items:["自動模式關閉：複製到剪貼簿，適合臨時引用。","自動模式開啟：更適合直接寫入當前工作流；在已繫結 Canvas 的場景下，也會參與聯動流程。","選中工具欄支援複製或插入、搜尋、制卡、閱讀點、AI 等操作。"]}]},{title:"摘錄格式與定位連結",paragraphs:["閱讀器會盡量為摘錄附帶精確定位資訊，讓你可以從筆記反跳回原文位置。","如果摘錄包含想法，推薦把想法寫在 ---div--- 分隔區之後，後續會自動在正文顯示想法氣泡。"],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> 摘錄正文
> ---div---
> 想法正文`},{title:"書籤與閱讀位置",paragraphs:["每本書對應庫內一份專有 Markdown（預設 Weave EPUB Reader/data_{書名}.md），閱讀進度與書籤列表寫入該檔案 YAML，隨 Vault 全平臺同步。"],listGroups:[{items:["當前頁書籤：寫入專有 MD 的 bookmarks 列表，在側欄書籤頁管理。","閱讀進度：寫入專有 MD 的 readingState，連續閱讀與關閉閱讀器時自動儲存，開啟書籍時自動恢復。","參考閱讀位置：高階功能，記錄在外掛本地狀態，通常不隨庫同步。"]}]}],cye=[{title:"匯出為 Markdown",paragraphs:["匯出入口以閱讀器檢視選單為準，適合把內容沉澱回倉庫中的長期筆記。"],listGroups:[{items:["匯出當前章節：把當前章轉成 Markdown，並儘量把圖片寫成 Obsidian 友好的附件引用。","匯出本書高亮摘錄：整理當前書籍的標註與摘錄，便於後續再加工。"]}]},{title:"截圖與 Canvas 聯動",listGroups:[{heading:"截圖",items:["截圖模式下可在閱讀區域拖拽截圖。","圖片模式：儲存為圖片檔案；自動模式開啟時可直接插入。","嵌入模式：儘量提取文字並生成帶定位的引用；自動模式關閉時會優先複製結果。"]},{heading:"Canvas",items:["可以為當前書建立新的 Canvas 腦圖，也可以繫結已有 Canvas。","繫結後可開啟、繼續編輯或斷開聯動，適合做章節結構圖、問題樹和閱讀路線。"]}]},{title:"常用入口與快捷鍵",shortcuts:[{keys:["←","→"],description:"翻頁模式且 EPUB 檢視獲得焦點時切換前後頁（連續滾動模式不佔用方向鍵）。"},{keys:["←","→","PageUp","PageDown"],description:"段落閱讀模式下面板獲得焦點時，在段內或相鄰段落間移動。"},{keys:["Esc"],description:"關閉當前教程，或在已聚焦的閱讀器彈層上退出當前層。"}],buttons:[{icon:"list",label:"側邊欄",description:"切換目錄、筆記、書籤與書架相關入口。"},{icon:"a-large-small",label:"排版設定",description:"調整行高、字間距、頁邊距等閱讀引數。"},{icon:"arrow-up-down",label:"閱讀流",description:"在翻頁與連續滾動之間切換。"},{icon:"scroll-text",label:"頁面佈局",description:"在單頁與雙欄佈局之間切換。"},{icon:"bookmark",label:"當前頁書籤",description:"記錄當前頁位。"},{icon:"flag",label:"參考閱讀位置",description:"儲存或更新參考閱讀錨點。"},{icon:"layout-dashboard",label:"Canvas 腦圖",description:"建立、繫結或管理閱讀腦圖。"},{icon:"camera",label:"截圖工具",description:"進入截圖工作流。"},{icon:"zap",label:"自動模式",description:"切換複製型輸出與自動插入型輸出。"},{icon:"circle-help",label:"使用教程",description:"再次開啟本教程。"}]}],uye=[{title:"Weave 是什麼",paragraphs:["Weave 是一組面向 Obsidian 的知識工作流外掛，圍繞「讀 → 記 → 排 → 複習」組織長期學習。","Weave EPUB Reader（本外掛）負責在庫內讀書與摘錄；Weave 主外掛負責記憶牌組、題庫與智慧制卡；Weave Incremental Reading 負責增量閱讀佇列與月曆排期。"],listGroups:[{heading:"三者分工",items:["Weave EPUB Reader：在 Obsidian 內閱讀書籍，管理摘錄與高亮，並與筆記、Canvas、牌組聯動。","Weave 主外掛：從 Obsidian 任意檔案的段落摘錄生成帶溯源連結的記憶卡片，並以表格、看板、網格等視圖管理與複習。","Weave Incremental Reading：把「以後再看」的內容整理成閱讀點佇列，用專題與月曆調度多書、多章節的推進節奏。"]}]},{title:"Weave EPUB Reader（當前外掛）",paragraphs:["讓 Obsidian 不只是筆記倉庫，也是你正經讀書的地方：在 Vault 內開啟 EPUB、TXT 等書籍，邊讀邊摘錄，並透過深連結與正文回顯，把「書裡的句子」和「庫裡的筆記」連在一起。"],listGroups:[{heading:"核心功能",items:["書架與閱讀：多格式書籍管理、目錄跳轉、翻頁/捲動、版式與主題、閱讀進度與書籤。","摘錄與高亮：選區工具欄、五種高亮色與多種線性標註、想法氣泡、自動或手動寫入 Markdown / Canvas / Weave 牌組。","溯源與回顯：摘錄保留定位資訊；筆記側修改後，書中高亮同步更新；可從高亮反查來源筆記、Canvas 或牌組。","擴展工作流：章節匯出、截圖、Canvas 綁定、段落閱讀模式；與 Weave 主外掛銜接制卡與 AI，與增量閱讀外掛銜接章節排期與閱讀點。","以及更多"]}]},{title:"Weave 主外掛",paragraphs:["Weave 是基於 Obsidian 的知識卡片系統：從庫內任意檔案的任意段落摘錄，生成帶有溯源連結的記憶卡片；所有卡片都可保留溯源定位資訊，便於隨時跳回原文。","你可以用表格視圖、看板視圖、網格卡片視圖瀏覽和管理 Weave 中的全部卡片與牌組。"],listGroups:[{heading:"核心功能",items:["摘錄制卡：從 Markdown、PDF、EPUB 閱讀器、Canvas 等任意來源的段落或選區建立記憶卡片，並附帶回到原文的溯源連結。","多視圖管理：以表格視圖、看板視圖、網格卡片視圖瀏覽、篩選、組織全部卡片與牌組。","側邊欄網格視圖：將網格卡片視圖移入 Obsidian 側邊欄後，可關聯目前活動的 Markdown 文件，只顯示與該文件相關的卡片；並支援基於目前文件進行 AI 制卡、解析並匯入卡片。","題庫與練習：解析題庫 Markdown 文件，匯入題目並開始習題測試；支援錯題本與考試統計。","間隔複習：FSRS 調度演算法、學習會話、進度統計與牌組管理。","以及更多"]}]},{title:"Weave Incremental Reading（增量閱讀外掛）",paragraphs:["解決「收藏很多、同時開很多本書卻都讀不深」的問題：把 Markdown、PDF 選區、Canvas、網頁、EPUB 章節等零散材料，整理成可排期、可續讀、可回跳的閱讀點佇列，用月曆推進而不是靠意志力硬啃。"],listGroups:[{heading:"核心功能",items:["閱讀點與專題（IRDeck）：從文件選區、區塊連結、閱讀器選中文字等建立閱讀點，歸入 .irdeck 專題。","增量閱讀月曆：按日期查看待處理、已排期與逾期的閱讀點，安排每日閱讀任務。","調度與續讀：支援每日上限、時間預算、交錯閱讀等策略；標記續讀點後，可一鍵回到原文位置繼續。","來源回跳：閱讀點保留來源資訊，從佇列跳回 Markdown、PDF、EPUB 等原始位置。","與閱讀器聯動：在本閱讀器目錄中可將章節「新增到增量閱讀」；選中文字可建立帶 EPUB 溯源連結的增量閱讀點。","以及更多"]}]},{title:"怎麼組合使用",paragraphs:["三款外掛職責分離、可按需組合，常見用法如下："],listGroups:[{items:["只想在 Obsidian 裡讀書、做摘錄：只裝 Weave EPUB Reader 即可。","讀完要複習、要制卡：EPUB Reader + Weave 主外掛；摘錄後可一鍵填充到制卡視窗，或 AI 拆分制卡。","多本書/長書要有節奏：EPUB Reader + Weave Incremental Reading；章節進月曆排期，到調度日再深連結回書中精讀。","完整閉環（讀 → 記 → 排 → 複習）：三款都裝；讀書摘錄 → 制卡複習 → 章節/段落進增量佇列，長期推進。"]}]}],dye=[{title:"EPUB 解析與閱讀核心",paragraphs:["EPUB 檔案閱讀現已完全基於 foliate-js 核心，歷史閱讀定位與已有資料會盡量相容遷移。"]},{title:"連結與知識沉澱",paragraphs:["EPUB 精確連結與回跳工作流參考了 Obsidian PDF++ 的優秀思路，同時結合了 Obsidian 的雙向連結與圖譜能力。"]},{title:"閱讀與 Canvas 聯動",paragraphs:["EPUB 閱讀器與 Obsidian Canvas 的聯動體驗參考了 MarginNote 的閱讀與腦圖工作流，並繼續沿著 Obsidian 原生檔案體系演進。"]},{title:"段落閱讀設計參考",paragraphs:["段落閱讀模式的設計思路參考了 Readest 閱讀軟體的段落模式體驗，並結合 EPUB 閱讀器自身的定位、摘錄與腳註工作流做了適配。"]},{title:"工具條設計參考",paragraphs:["選中文字後的工具條互動設計參考了微信讀書的工具條體驗。"]},{title:"詞典外掛相容致謝",paragraphs:["感謝群友為 Obsidian 開發的詞典外掛 obsdian-fingertip-translation。該外掛原本支援 Obsidian Markdown 編輯介面的劃詞詞典體驗，經過相容性處理後，也可以在本 EPUB 閱讀器中正常使用。","閱讀器自身不內建詞典功能，相關詞典解釋與彈窗能力由該外部外掛提供。"],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],pye={basics:oye,highlight:sye,workflow:lye,tools:cye,family:uye,credits:dye},hye=[{title:"Open and restore",paragraphs:["Put a book file into your Obsidian vault and click it to open. The reader automatically saves and restores reading progress, typography preferences, and the current reading state.","Currently supported formats are .epub, .mobi, .azw3, .fb2, .fbz, .txt, and .cbz. In practice, EPUB, FB2/FBZ, and TXT are better for structured export, while CBZ is more image-oriented."]},{title:"Sidebar and bookshelf",paragraphs:["The reader supports both a local sidebar and a global bookshelf view so you can switch between books, the table of contents, and annotations inside the same note-taking workspace."],listGroups:[{items:["TOC: jump quickly by chapter.","Notes: review synced highlights, thoughts, and related content for the current book.","Bookmarks: manage bookmarks for the current page.","My Bookshelf: browse book files in the vault and return from the bookshelf subview to the current book sidebar."]}]},{title:"Reading modes and layout",listGroups:[{heading:"Reading flow",items:["Paged mode: best for linear reading and keyboard page turns.","Scrolled mode: best for longer passages, footnote round-trips, and quickly searching nearby context."]},{heading:"Page layout",items:["Single page: the default layout for most situations.","Double column: closer to the feel of an open book and automatically switches to a wider display."]},{heading:"Width mode",items:["standard: standard reading width for long-form immersive reading.","full: a wider layout that still keeps comfortable margins on larger screens.","edge: a true edge-to-edge mode that uses as much host width as possible."]}]},{title:"Display settings and helpers",paragraphs:["Reader settings cover more than width. They also include typography, footnotes, and top information display so you can tune the experience by book type."],listGroups:[{items:["The typography panel adjusts line height, letter spacing, and page margins, and can restore defaults.","Scrolled mode can independently toggle the right-side page buttons.","Footnote marker clicks can switch between showing a footnote popover and jumping directly to the footnote."]}]}],fye=[{title:"Annotation styles",paragraphs:["Selecting text opens the toolbar and supports color highlights plus multiple inline annotation styles. Color, style, and location data are all saved and restored together."],colors:[{tone:"yellow",label:"Yellow",description:"general marking"},{tone:"green",label:"Green",description:"key content"},{tone:"blue",label:"Blue",description:"thinking notes"},{tone:"red",label:"Red",description:"questions and doubts"},{tone:"purple",label:"Purple",description:"extended associations"}],listGroups:[{heading:"Styles",items:["Highlight: best for standard excerpts.","Underline: keeps the page background while emphasizing key sentences.","Strikethrough: useful for content to ignore, revise, or conceal.","Wavy underline: useful for problems, uncertainties, or passages that need another pass."]}]},{title:"Thought bubbles and footnote popovers",paragraphs:["Thought bubbles in the text are additional cues. They do not replace or weaken the highlight, underline, strikethrough, or wavy underline itself.","As long as the excerpt contains a `---div---` separator, the reader shows a thought bubble beside the highlight. You can edit it from the bubble or from the toolbar thought action.","Footnote marker clicks can be configured to show a popover preview or jump directly to the footnote location."]},{title:"Restore and sync",listGroups:[{items:["Highlights, styles, and thoughts automatically reappear when you reopen the same book.","Data sources consistently support Markdown, Canvas, and card data instead of relying on a separate black-box database.","Source links are the authoritative record for restoring and locating excerpts. As long as the link remains valid, you can freely rewrite the excerpt body.","When a note file changes, the reader reloads the related highlights so the book view and note view stay in sync."]}]}],gye=[{title:"How automated excerpts work",paragraphs:["In the reader, selecting text and highlighting only shows briefly — it does not save excerpt data. To keep excerpts permanently, create or choose a Markdown note, Canvas, or Weave destination, pick where to insert, and the reader will write to that location automatically.","Many users expect highlighting alone to save a note. In practice, you must create or choose a target file first; only then is the excerpt written to your vault for long-term storage."],listGroups:[{heading:"Saving and aggregating excerpts",items:["Reading excerpts live in Markdown, Canvas, and Weave cards; the reader aggregates them in one place.","You can edit card body text freely, but do not change source links — that breaks location and re-display.","To save permanently, use the selection toolbar to pick a target: create or choose Markdown, bind Canvas, or excerpt to Weave."]}]},{title:"Auto mode and the selection toolbar",paragraphs:["Auto mode decides the default output path after selecting text: off leans toward copying, while on leans toward writing directly into your current workflow."],listGroups:[{items:["Auto mode off: copy to the clipboard for temporary quoting.","Auto mode on: better for writing directly into the current workflow and also participates in Canvas-linked flows.","The selection toolbar supports copy or insert, search, card creation, reading points, AI actions, and more."]}]},{title:"Excerpt format and source links",paragraphs:["The reader tries to attach precise location data to excerpts so you can jump back from notes to the source passage.","If an excerpt includes a thought, putting it after the `---div---` separator is recommended so the thought bubble can appear in the text automatically."],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> Excerpt body
> ---div---
> Thought body`},{title:"Bookmarks and reading positions",listGroups:[{items:["Current-page bookmark: leave a quick return point for the current page.","Last reading point: save the recent reading location you want to keep long term.","Reading reference point: record a main reading anchor so you can return after branching out.","Incremental reading resume point: work with incremental reading as the next entry point for processing."]}]}],mye=[{title:"Export to Markdown",paragraphs:["Use the reader view menu as the export entry point when you want to turn reading output into long-term vault notes."],listGroups:[{items:["Export current chapter: convert the current chapter to Markdown and keep images as Obsidian-friendly attachments whenever possible.","Export book highlights: organize annotations and excerpts from the current book for later refinement."]}]},{title:"Screenshots and Canvas integration",listGroups:[{heading:"Screenshots",items:["In screenshot mode you can drag a capture area over the reading viewport.","Image mode: save as an image file and insert directly when auto mode is on.","Embed mode: extract text when possible and generate a location-aware reference; when auto mode is off it prefers copying the result."]},{heading:"Canvas",items:["You can create a new Canvas map for the current book or bind an existing Canvas.","After binding, you can open it, keep editing it, or disconnect it, which works well for chapter maps, question trees, and reading routes."]}]},{title:"Common entry points and shortcuts",shortcuts:[{keys:["←","→"],description:"When paged mode is active and the EPUB view is focused, move to the previous or next page (scrolled mode does not use arrow keys)."},{keys:["←","→","PageUp","PageDown"],description:"In paragraph reading mode, move within or across paragraphs when the paragraph panel is focused."},{keys:["Esc"],description:"Close the tutorial, or dismiss the currently focused reader overlay."}],buttons:[{icon:"list",label:"Sidebar",description:"Switch between TOC, notes, bookmarks, and bookshelf-related entry points."},{icon:"a-large-small",label:"Typography",description:"Adjust line height, letter spacing, page margins, and other reading parameters."},{icon:"arrow-up-down",label:"Reading flow",description:"Switch between paged and scrolled reading."},{icon:"scroll-text",label:"Page layout",description:"Switch between single-page and double-column layouts."},{icon:"bookmark",label:"Current bookmark",description:"Record the current page position."},{icon:"flag",label:"Reference point",description:"Save or update the reading reference anchor."},{icon:"layout-dashboard",label:"Canvas map",description:"Create, bind, or manage the reading map."},{icon:"camera",label:"Screenshot tool",description:"Enter the screenshot workflow."},{icon:"zap",label:"Auto mode",description:"Switch between copy-first and auto-insert output."},{icon:"circle-help",label:"Tutorial",description:"Open this tutorial again."}]}],bye=[{title:"What is Weave",paragraphs:["Weave is a family of Obsidian plugins built around long-term learning: read → capture → schedule → review.","Weave EPUB Reader (this plugin) handles in-vault reading and excerpts; the Weave main plugin handles memory decks, question banks, and smart card creation; Weave Incremental Reading handles reading-point queues and calendar scheduling."],listGroups:[{heading:"How the three plugins divide work",items:["Weave EPUB Reader: read books in Obsidian, manage highlights and excerpts, and connect with notes, Canvas, and decks.","Weave main plugin: create memory cards with source links from any paragraph in any vault file, and manage and review them in table, kanban, and grid views.","Weave Incremental Reading: organize “read later” material into reading-point queues and advance multiple books and chapters through topics and a month calendar."]}]},{title:"Weave EPUB Reader (this plugin)",paragraphs:["Make Obsidian more than a note archive—a place where you actually read: open EPUB, TXT, and other books in your vault, excerpt as you go, and keep passages linked to your notes through deep links and in-body rendering."],listGroups:[{heading:"Core capabilities",items:["Bookshelf and reading: multi-format library, TOC navigation, paged/scrolled modes, typography and themes, progress and bookmarks.","Excerpts and highlights: selection toolbar, five highlight colors and linear mark styles, thought bubbles, auto or manual capture to Markdown, Canvas, or Weave decks.","Tracing and re-display: excerpts keep location data; highlights refresh when notes change; jump from a highlight back to the source note, Canvas, or deck.","Extended workflows: chapter export, screenshots, Canvas binding, paragraph reading mode; card creation and AI via the Weave main plugin; chapter scheduling and reading points via incremental reading.","And more"]}]},{title:"Weave main plugin",paragraphs:["Weave is an Obsidian-based knowledge card system: excerpt any paragraph from any file in your vault to create memory cards with source-tracing links. Every card can keep location metadata so you can jump back to the original passage.","Browse and manage all Weave cards and decks in table view, kanban view, and grid card view."],listGroups:[{heading:"Core capabilities",items:["Excerpt to card: create memory cards from paragraphs or selections in Markdown, PDF, the EPUB reader, Canvas, and other sources, each with a link back to the source.","Multi-view management: browse, filter, and organize all cards and decks in table, kanban, and grid card views.","Sidebar grid view: dock the grid card view in Obsidian’s sidebar to filter cards by the currently active Markdown file; also supports AI card creation from the active document, parsing and importing cards.","Question bank and practice: parse question-bank Markdown files, import questions, and start exercise tests; includes error book and exam statistics.","Spaced repetition: FSRS scheduling, study sessions, progress stats, and deck management.","And more"]}]},{title:"Weave Incremental Reading",paragraphs:["For when you save a lot but never read deeply across many books: turn scattered material from Markdown, PDF selections, Canvas, web pages, and EPUB chapters into a schedulable, resumable, source-linked reading-point queue—advanced through a calendar instead of willpower alone."],listGroups:[{heading:"Core capabilities",items:["Reading points and topics (IRDeck): create points from document selections, block links, reader selections, and more; organize them into .irdeck topics.","Incremental reading calendar: see pending, scheduled, and overdue points by date and plan daily reading tasks.","Scheduling and resume: daily limits, time budgets, interleaved reading, and one-click return to the exact source position.","Source jump-back: reading points keep source metadata so you can return to Markdown, PDF, EPUB, and other origins.","Reader integration: add chapters from this reader’s TOC to incremental reading; create reading points with EPUB source deep links from selected text.","And more"]}]},{title:"How to combine them",paragraphs:["The three plugins have separate roles and can be mixed as needed. Common setups:"],listGroups:[{items:["Read and excerpt only in Obsidian: Weave EPUB Reader alone is enough.","Review and make cards after reading: EPUB Reader + Weave main plugin—fill the card window from excerpts or use AI split-to-card.","Pace multiple or long books: EPUB Reader + Weave Incremental Reading—schedule chapters on the calendar and deep-link back on due days.","Full loop (read → capture → schedule → review): install all three—excerpt while reading, review with cards, queue chapters and passages for incremental reading."]}]}],vye=[{title:"EPUB parsing and reading engine",paragraphs:["EPUB reading is now fully based on the foliate-js engine, while historical reading positions and existing data are migrated as compatibly as possible."]},{title:"Links and knowledge capture",paragraphs:["The precise EPUB link and jump-back workflow was inspired by the excellent ideas behind Obsidian PDF++ and combined with Obsidian backlinks and graph capabilities."]},{title:"Reading and Canvas integration",paragraphs:["The integration between the EPUB reader and Obsidian Canvas was inspired by MarginNote-style reading and mind-map workflows while continuing to evolve within Obsidian’s native file system."]},{title:"Paragraph mode inspiration",paragraphs:["The paragraph reading mode was inspired by the paragraph mode experience in the Readest reading app, then adapted to fit this reader’s location, excerpt, and footnote workflows."]},{title:"Toolbar interaction reference",paragraphs:["The text-selection toolbar interaction takes inspiration from the reading toolbar experience in WeRead."]},{title:"Dictionary plugin compatibility",paragraphs:["Thanks to the community-built Obsidian plugin `obsdian-fingertip-translation`. It originally brought in-editor word-lookup support to Obsidian Markdown editing and can now also work inside this EPUB reader after compatibility handling.","The reader itself does not bundle a dictionary. Dictionary explanations and related popovers are provided by that external plugin."],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],yye={basics:hye,highlight:fye,workflow:gye,tools:mye,family:bye,credits:vye},wye=[{title:"開くと復元",paragraphs:["書籍ファイルを Obsidian ヴォールトに入れ、クリックして開きます。リーダーは読書の進捗、タイポグラフィ設定、現在の読書状態を自動的に保存・復元します。","現在サポートしている形式は .epub、.mobi、.azw3、.fb2、.fbz、.txt、.cbz です。実用上は EPUB、FB2/FBZ、TXT が構造化エクスポートに向いており、CBZ は画像中心の形式です。"]},{title:"サイドバーとブックシェルフ",paragraphs:["リーダーはローカルサイドバーとグローバルなブックシェルフ表示の両方に対応しており、同じノートワークスペース内で書籍、目次、注釈を切り替えられます。"],listGroups:[{items:["目次：章ごとに素早くジャンプできます。","ノート：現在の書籍の同期済みハイライト、コメント、関連コンテンツを確認できます。","ブックマーク：現在のページのブックマークを管理できます。","マイブックシェルフ：ヴォールト内の書籍ファイルを閲覧し、ブックシェルフのサブビューから現在の書籍サイドバーに戻れます。"]}]},{title:"読書モードとレイアウト",listGroups:[{heading:"読書フロー",items:["ページ送りモード：直線的な読書とキーボードでのページめくりに最適です。","スクロールモード：長い段落、脚注の往復、周辺文脈の素早い検索に最適です。"]},{heading:"ページレイアウト",items:["単一ページ：ほとんどの状況でのデフォルトレイアウトです。","二段組：開いた本のような感覚で、広い画面では自動的に切り替わります。"]},{heading:"幅モード",items:["standard：長文の没入読書向けの標準的な読書幅です。","full：大きな画面でも快適な余白を保ちながら、より広いレイアウトです。","edge：ホストの幅を最大限に使う、真のエッジツーエッジモードです。"]}]},{title:"表示設定と補助機能",paragraphs:["リーダー設定は幅だけでなく、タイポグラフィ、脚注、上部情報の表示も含みます。書籍の種類に合わせて読書体験を調整できます。"],listGroups:[{items:["タイポグラフィパネルで行間、字間、ページ余白を調整でき、デフォルトに戻すこともできます。","スクロールモードでは右側のページボタンを個別にオン・オフできます。","上部ステッカーは auto、inline、right-rail のレイアウトに対応しています。","脚注マーカーのクリックは、脚注ポップオーバーの表示と脚注への直接ジャンプを切り替えられます。"]}]}],kye=[{title:"注釈スタイル",paragraphs:["テキストを選択するとツールバーが開き、カラーハイライトと複数のインライン注釈スタイルが使えます。色、スタイル、位置データはまとめて保存・復元されます。"],colors:[{tone:"yellow",label:"イエロー",description:"一般的なマーキング"},{tone:"green",label:"グリーン",description:"重要な内容"},{tone:"blue",label:"ブルー",description:"思考メモ"},{tone:"red",label:"レッド",description:"疑問・疑い"},{tone:"purple",label:"パープル",description:"関連の拡張"}],listGroups:[{heading:"スタイル",items:["ハイライト：標準的な抜粋に最適です。","下線：ページ背景を保ちながら重要な文を強調します。","取り消し線：無視・修正・隠したい内容に便利です。","波線：問題点、不確かさ、再読が必要な箇所に便利です。"]}]},{title:"思考バブルと脚注ポップオーバー",paragraphs:["本文中の思考バブルは追加の手がかりです。ハイライト、下線、取り消し線、波線そのものを置き換えたり弱めたりしません。","抜粋に `---div---` 区切りが含まれていれば、リーダーはハイライトの横に思考バブルを表示します。バブルまたはツールバーの思考操作から編集できます。","脚注マーカーのクリックは、ポップオーバーでのプレビュー表示と脚注位置への直接ジャンプを設定できます。"]},{title:"復元と同期",listGroups:[{items:["ハイライト、スタイル、思考は同じ書籍を再度開くと自動的に再表示されます。","データソースは一貫して Markdown、Canvas、カードデータをサポートし、別のブラックボックス型データベースに依存しません。","ソースリンクは抜粋の復元と位置特定の正規記録です。リンクが有効な限り、抜粋本文は自由に書き換えられます。","ノートファイルが変更されると、リーダーは関連するハイライトを再読み込みし、書籍ビューとノートビューを同期します。"]}]}],Sye=[{title:"自動抜粋の仕組み",paragraphs:["リーダーでテキストを選択してハイライトしても、表示は一時的なだけで抜粋データは保存されません。永続的に残すには、Markdown ノート、Canvas、または Weave の保存先を新規作成または選択し、挿入位置を指定したうえで、指定位置へ自動書き込みする必要があります。","多くのユーザーは、ハイライトだけでノートが自動保存されると誤解しがちです。実際には、まず対象ファイルを新規作成または選択する必要があり、その後に初めて抜粋が Vault に書き込まれて長期保存されます。"],listGroups:[{heading:"抜粋の保存と集約表示",items:["読書抜粋ノートは Markdown、Canvas、Weave カードに保存され、リーダーが集約して表示します。","カード本文は自由に編集できますが、ソースリンクは変更しないでください。変更すると位置特定と再表示が壊れます。","永続保存するには、選択ツールバーから対象を選びます。Markdown の新規作成または選択、Canvas の連携、Weave への抜粋です。"]}]},{title:"オートモードと選択ツールバー",paragraphs:["オートモードはテキスト選択後のデフォルト出力先を決めます。オフはコピー寄り、オンは現在のワークフローへの直接書き込み寄りです。"],listGroups:[{items:["オートモード オフ：一時的な引用にはクリップボードへコピーします。","オートモード オン：現在のワークフローへの直接書き込みに適し、Canvas 連携フローにも参加します。","選択ツールバーはコピーまたは挿入、検索、カード作成、読書ポイント、AI アクションなどに対応しています。"]}]},{title:"抜粋形式とソースリンク",paragraphs:["リーダーは抜粋に正確な位置データを付与し、ノートから元の箇所へジャンプできるようにします。","抜粋に思考を含める場合は、`---div---` 区切りの後に置くことを推奨します。本文中に思考バブルが自動表示されます。"],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> Excerpt body
> ---div---
> Thought body`},{title:"ブックマークと読書位置",listGroups:[{items:["現在ページのブックマーク：現在のページに素早く戻るためのポイントを残します。","最終読書ポイント：長期保持したい直近の読書位置を保存します。","読書参照ポイント：分岐後に戻れるよう、主要な読書アンカーを記録します。","インクリメンタルリーディング再開ポイント：インクリメンタルリーディングと連携し、次の処理エントリーポイントとして機能します。"]}]}],xye=[{title:"Markdown へのエクスポート",paragraphs:["読書の成果をヴォールトの長期ノートにしたいときは、リーダービューのメニューをエクスポートの入口として使います。"],listGroups:[{items:["現在の章をエクスポート：現在の章を Markdown に変換し、可能な限り画像を Obsidian 向けの添付ファイルとして保持します。","書籍ハイライトをエクスポート：現在の書籍の注釈と抜粋を整理し、後から精緻化できます。"]}]},{title:"スクリーンショットと Canvas 連携",listGroups:[{heading:"スクリーンショット",items:["スクリーンショットモードでは、読書ビューポート上にキャプチャ領域をドラッグできます。","画像モード：画像ファイルとして保存し、オートモードがオンのときは直接挿入します。","埋め込みモード：可能ならテキストを抽出し、位置情報付きの参照を生成します。オートモードがオフのときは結果のコピーを優先します。"]},{heading:"Canvas",items:["現在の書籍用に新しい Canvas マップを作成するか、既存の Canvas を紐づけできます。","紐づけ後は開く、編集を続ける、接続を解除する操作ができ、章マップ、疑問ツリー、読書ルートに適しています。"]}]},{title:"よく使う入口とショートカット",shortcuts:[{keys:["←","→"],description:"ページ送りモードで EPUB ビューにフォーカスがあるとき、前後のページへ移動します（スクロールモードでは矢印キーは使いません）。"},{keys:["←","→","PageUp","PageDown"],description:"段落読書モードでは、段落パネルにフォーカスがあるとき、段落内または段落間を移動します。"},{keys:["Esc"],description:"チュートリアルを閉じるか、現在フォーカスされているリーダーオーバーレイを閉じます。"}],buttons:[{icon:"list",label:"サイドバー",description:"目次、ノート、ブックマーク、ブックシェルフ関連の入口を切り替えます。"},{icon:"a-large-small",label:"タイポグラフィ",description:"行間、字間、ページ余白などの読書パラメータを調整します。"},{icon:"arrow-up-down",label:"読書フロー",description:"ページ送りとスクロール読書を切り替えます。"},{icon:"scroll-text",label:"ページレイアウト",description:"単一ページと二段組レイアウトを切り替えます。"},{icon:"bookmark",label:"現在のブックマーク",description:"現在のページ位置を記録します。"},{icon:"flag",label:"参照ポイント",description:"読書参照アンカーを保存または更新します。"},{icon:"layout-dashboard",label:"Canvas マップ",description:"読書マップを作成、紐づけ、管理します。"},{icon:"camera",label:"スクリーンショットツール",description:"スクリーンショットワークフローに入ります。"},{icon:"zap",label:"オートモード",description:"コピー優先と自動挿入出力を切り替えます。"},{icon:"circle-help",label:"チュートリアル",description:"このチュートリアルを再度開きます。"}]}],Tye=[{title:"Weave とは",paragraphs:["Weave は Obsidian 向けの知識ワークフロー系プラグイン群で、「読む → 記す → 並べる → 復習する」という長期学習を支えます。","Weave EPUB Reader（本プラグイン）は Vault 内読書と抜粋、Weave 本体は記憶デッキ・問題集・スマート制卡、Weave Incremental Reading は増分読書キューとカレンダースケジュールを担当します。"],listGroups:[{heading:"3 つの役割分担",items:["Weave EPUB Reader：Obsidian 内で書籍を読み、抜粋とハイライトを管理し、ノート・Canvas・デッキと連携。","Weave 本体：Vault 内の任意ファイルの段落から溯源リンク付き記憶カードを作成し、表・看板・グリッド各ビューで管理・復習。","Weave Incremental Reading：「あとで読む」内容を読書点キューに整理し、トピックと月カレンダーで複数書籍・章の進行ペースを管理。"]}]},{title:"Weave EPUB Reader（本プラグイン）",paragraphs:["Obsidian をノート倉庫だけでなく、本当に読書する場所にします。Vault 内で EPUB や TXT などを開き、読みながら抜粋し、深リンクと本文反映で「本の一文」と「Vault のノート」をつなぎます。"],listGroups:[{heading:"コア機能",items:["本棚と読書：多形式書籍管理、目次ジャンプ、ページ/スクロール、組版とテーマ、進捗とブックマーク。","抜粋とハイライト：選択ツールバー、5 色ハイライトと線形マーク、思考バブル、Markdown / Canvas / Weave デッキへの自動または手動書き込み。","ソース追跡と再表示：抜粋に位置情報を保持；ノート変更後も本文ハイライトを同期；ハイライトから元ノート・Canvas・デッキへ逆引き。","拡張ワークフロー：章エクスポート、スクリーンショット、Canvas 連携、段落読書モード；Weave 本体での制卡・AI、増分読書での章スケジュール・読書点連携。","その他多数"]}]},{title:"Weave 本体",paragraphs:["Weave は Obsidian ベースの知識カードシステムです。Vault 内の任意ファイルの任意段落から抜粋し、ソース追跡リンク付きの記憶カードを生成します。すべてのカードに溯源定位情報を保持でき、いつでも原文へ戻れます。","表ビュー、看板ビュー、グリッドカードビューですべての Weave カードとデッキを閲覧・管理できます。"],listGroups:[{heading:"コア機能",items:["抜粋制卡：Markdown、PDF、EPUB リーダー、Canvas など任意ソースの段落・選択から記憶カードを作成し、原文への溯源リンクを付与。","マルチビュー管理：表・看板・グリッドカード各ビューですべてのカードとデッキを閲覧・フィルタ・整理。","サイドバーグリッドビュー：グリッドカードビューを Obsidian サイドバーに移すと、現在アクティブな Markdown 文書に関連するカードだけを表示；アクティブ文書に基づく AI 制卡、解析・カードインポートにも対応。","問題集と演習：問題集 Markdown を解析して問題をインポートし、演習テストを開始；誤答帳・試験統計にも対応。","間隔反復：FSRS スケジューリング、学習セッション、進捗統計、デッキ管理。","その他多数"]}]},{title:"Weave Incremental Reading（増分読書プラグイン）",paragraphs:["「保存は多いのに、複数の本を同時に開いても深く読めない」問題に対応します。Markdown、PDF 選択、Canvas、Web ページ、EPUB 章などの断片を、スケジュール可能・再開可能・ソースへ戻れる読書点キューに整理し、意志力だけに頼らず月カレンダーで進めます。"],listGroups:[{heading:"コア機能",items:["読書点とトピック（IRDeck）：文書選択、ブロックリンク、リーダー選択テキストなどから読書点を作成し .irdeck トピックに整理。","増分読書カレンダー：未処理・予定・期限切れの読書点を日付で確認し、日次タスクを組み立て。","スケジュールと再開：日次上限、時間予算、インターリーブなど；再開点から原文位置へワンクリック復帰。","ソースへ戻る：読書点にソース情報を保持し、Markdown・PDF・EPUB などへジャンプ。","リーダー連携：本リーダーの目次から章を増分読書へ追加；選択テキストから EPUB ソース深リンク付き読書点を作成。","その他多数"]}]},{title:"組み合わせ方",paragraphs:["3 つのプラグインは役割が分かれており、必要に応じて組み合わせられます。よくある使い方："],listGroups:[{items:["Obsidian 内で読書・抜粋だけ：Weave EPUB Reader のみで十分。","読後に復習・制卡：EPUB Reader + Weave 本体；抜粋を制卡ウィンドウへ送るか AI 分割制卡。","複数書籍・長編のペース管理：EPUB Reader + Weave Incremental Reading；章を月カレンダーに載せ、予定日に深リンクで精読。","完全ループ（読む → 記す → 並べる → 復習する）：3 つすべて；読書抜粋 → 制卡復習 → 章/段落を増分キューへ。"]}]}],Cye=[{title:"EPUB 解析と読書エンジン",paragraphs:["EPUB 読書は foliate-js エンジンを完全にベースにしており、過去の読書位置と既存データは可能な限り互換性を保って移行されます。"]},{title:"リンクと知識のキャプチャ",paragraphs:["正確な EPUB リンクと元の箇所へ戻るワークフローは、Obsidian PDF++ の優れたアイデアに触発され、Obsidian のバックリンクとグラフ機能と組み合わされています。"]},{title:"読書と Canvas 連携",paragraphs:["EPUB リーダーと Obsidian Canvas の連携は、MarginNote スタイルの読書とマインドマップのワークフローに触発され、Obsidian のネイティブファイルシステム内で進化を続けています。"]},{title:"段落モードの着想",paragraphs:["段落読書モードは Readest 読書アプリの段落モード体験に触発され、このリーダーの位置、抜粋、脚注ワークフローに合わせて適応されました。"]},{title:"ツールバー操作の参考",paragraphs:["テキスト選択ツールバーの操作は、WeRead の読書ツールバー体験から着想を得ています。"]},{title:"辞書プラグインとの互換性",paragraphs:["コミュニティ製 Obsidian プラグイン `obsdian-fingertip-translation` に感謝します。もともと Obsidian の Markdown 編集にエディター内の単語検索をもたらし、互換性対応の後、この EPUB リーダー内でも動作するようになりました。","リーダー自体に辞書は同梱されていません。辞書の説明と関連ポップオーバーは、その外部プラグインが提供します。"],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],Eye={basics:wye,highlight:kye,workflow:Sye,tools:xye,family:Tye,credits:Cye},_ye=[{title:"열기 및 복원",paragraphs:["책 파일을 Obsidian 보관함에 넣고 클릭하여 엽니다. 리더는 읽기 진행 상황, 타이포그래피 설정, 현재 읽기 상태를 자동으로 저장하고 복원합니다.","현재 지원 형식은 .epub, .mobi, .azw3, .fb2, .fbz, .txt, .cbz입니다. 실제로는 EPUB, FB2/FBZ, TXT가 구조화된 보내기에 더 적합하고, CBZ는 이미지 중심 형식입니다."]},{title:"사이드바와 책장",paragraphs:["리더는 로컬 사이드바와 전역 책장 보기를 모두 지원하여, 같은 노트 작업 공간 안에서 책, 목차, 주석을 전환할 수 있습니다."],listGroups:[{items:["목차: 장별로 빠르게 이동합니다.","노트: 현재 책의 동기화된 하이라이트, 코멘트, 관련 콘텐츠를 확인합니다.","북마크: 현재 페이지의 북마크를 관리합니다.","내 책장: 보관함의 책 파일을 둘러보고, 책장 하위 보기에서 현재 책 사이드바로 돌아갑니다."]}]},{title:"읽기 모드와 레이아웃",listGroups:[{heading:"읽기 흐름",items:["페이지 모드: 순차 읽기와 키보드 페이지 넘김에 가장 적합합니다.","스크롤 모드: 긴 구절, 각주 왕복, 주변 맥락 빠른 검색에 가장 적합합니다."]},{heading:"페이지 레이아웃",items:["단일 페이지: 대부분의 상황에서 기본 레이아웃입니다.","이단: 펼친 책 같은 느낌이며, 넓은 화면에서 자동으로 전환됩니다."]},{heading:"너비 모드",items:["standard: 장문 몰입 읽기를 위한 표준 읽기 너비입니다.","full: 큰 화면에서도 편안한 여백을 유지하는 더 넓은 레이아웃입니다.","edge: 호스트 너비를 최대한 활용하는 진정한 전체 너비 모드입니다."]}]},{title:"표시 설정과 보조 기능",paragraphs:["리더 설정은 너비뿐 아니라 타이포그래피, 각주, 상단 정보 표시도 포함합니다. 책 유형에 맞게 읽기 경험을 조정할 수 있습니다."],listGroups:[{items:["타이포그래피 패널에서 줄 간격, 자간, 페이지 여백을 조정하고 기본값으로 복원할 수 있습니다.","스크롤 모드에서는 오른쪽 페이지 버튼을 독립적으로 켜고 끌 수 있습니다.","상단 스티커는 auto, inline, right-rail 레이아웃을 지원합니다.","각주 마커 클릭은 각주 팝오버 표시와 각주 위치로 바로 이동 사이를 전환할 수 있습니다."]}]}],Pye=[{title:"주석 스타일",paragraphs:["텍스트를 선택하면 도구 모음이 열리며, 색상 하이라이트와 여러 인라인 주석 스타일을 지원합니다. 색상, 스타일, 위치 데이터가 함께 저장되고 복원됩니다."],colors:[{tone:"yellow",label:"노란색",description:"일반 표시"},{tone:"green",label:"초록색",description:"핵심 내용"},{tone:"blue",label:"파란색",description:"생각 메모"},{tone:"red",label:"빨간색",description:"질문과 의문"},{tone:"purple",label:"보라색",description:"연관 확장"}],listGroups:[{heading:"스타일",items:["하이라이트: 표준 발췌에 가장 적합합니다.","밑줄: 페이지 배경을 유지하면서 핵심 문장을 강조합니다.","취소선: 무시·수정·숨길 내용에 유용합니다.","물결 밑줄: 문제점, 불확실성, 다시 읽어야 할 구절에 유용합니다."]}]},{title:"생각 말풍선과 각주 팝오버",paragraphs:["본문의 생각 말풍선은 추가 단서입니다. 하이라이트, 밑줄, 취소선, 물결 밑줄 자체를 대체하거나 약화시키지 않습니다.","발췌에 `---div---` 구분자가 포함되어 있으면, 리더는 하이라이트 옆에 생각 말풍선을 표시합니다. 말풍선이나 도구 모음의 생각 작업에서 편집할 수 있습니다.","각주 마커 클릭은 팝오버 미리보기 표시와 각주 위치로 바로 이동하도록 설정할 수 있습니다."]},{title:"복원과 동기화",listGroups:[{items:["하이라이트, 스타일, 생각은 같은 책을 다시 열면 자동으로 다시 나타납니다.","데이터 소스는 일관되게 Markdown, Canvas, 카드 데이터를 지원하며, 별도의 블랙박스 데이터베이스에 의존하지 않습니다.","소스 링크는 발췌 복원과 위치 확인의 정식 기록입니다. 링크가 유효한 한 발췌 본문은 자유롭게 수정할 수 있습니다.","노트 파일이 변경되면 리더는 관련 하이라이트를 다시 불러와 책 보기와 노트 보기를 동기화합니다."]}]}],Mye=[{title:"자동 발췌 동작 방식",paragraphs:["리더에서 텍스트를 선택해 하이라이트하면 잠시만 표시되며, 발췌 데이터는 저장되지 않습니다. 영구 저장하려면 Markdown 노트, Canvas 또는 Weave 대상을 새로 만들거나 선택하고, 삽입 위치를 지정한 뒤 해당 위치에 자동으로 기록해야 합니다.","많은 사용자가 하이라이트만으로 노트가 자동 저장된다고 오해합니다. 실제로는 먼저 대상 파일을 새로 만들거나 선택해야 하며, 그 후에야 발췌가 Vault에 기록되어 장기 보관됩니다."],listGroups:[{heading:"발췌 저장과 집계 표시",items:["읽기 발췌 노트는 Markdown, Canvas, Weave 카드에 저장되며, 리더가 이를 집계해 표시합니다.","카드 본문은 자유롭게 편집할 수 있지만, 소스 링크는 수정하지 마세요. 수정하면 위치 지정과 재표시가 깨집니다.","영구 저장하려면 선택 도구 모음에서 대상을 고르세요. Markdown 생성 또는 선택, Canvas 연동, Weave 발췌입니다."]}]},{title:"자동 모드와 선택 도구 모음",paragraphs:["자동 모드는 텍스트 선택 후 기본 출력 경로를 결정합니다. 끔은 복사 쪽에, 켬은 현재 워크플로에 직접 쓰기 쪽에 가깝습니다."],listGroups:[{items:["자동 모드 끔: 임시 인용을 위해 클립보드에 복사합니다.","자동 모드 켬: 현재 워크플로에 직접 쓰기에 적합하며 Canvas 연동 흐름에도 참여합니다.","선택 도구 모음은 복사 또는 삽입, 검색, 카드 만들기, 읽기 포인트, AI 작업 등을 지원합니다."]}]},{title:"발췌 형식과 소스 링크",paragraphs:["리더는 발췌에 정확한 위치 데이터를 붙여 노트에서 원문 구절로 다시 이동할 수 있게 합니다.","발췌에 생각이 포함되면 `---div---` 구분자 뒤에 두는 것을 권장합니다. 본문에 생각 말풍선이 자동으로 표시됩니다."],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> Excerpt body
> ---div---
> Thought body`},{title:"북마크와 읽기 위치",listGroups:[{items:["현재 페이지 북마크: 현재 페이지에 빠르게 돌아올 지점을 남깁니다.","마지막 읽기 포인트: 장기 보관할 최근 읽기 위치를 저장합니다.","읽기 참조 포인트: 분기 후 돌아올 수 있도록 주요 읽기 앵커를 기록합니다.","점진적 읽기 재개 포인트: 점진적 읽기와 연동하여 다음 처리 진입점으로 작동합니다."]}]}],Aye=[{title:"Markdown으로 보내기",paragraphs:["읽기 결과를 보관함의 장기 노트로 만들고 싶을 때 리더 보기 메뉴를 보내기 진입점으로 사용합니다."],listGroups:[{items:["현재 장 보내기: 현재 장을 Markdown으로 변환하고, 가능한 한 이미지를 Obsidian 친화적 첨부 파일로 유지합니다.","책 하이라이트 보내기: 현재 책의 주석과 발췌를 정리하여 나중에 다듬을 수 있습니다."]}]},{title:"스크린샷과 Canvas 연동",listGroups:[{heading:"스크린샷",items:["스크린샷 모드에서는 읽기 뷰포트 위에 캡처 영역을 드래그할 수 있습니다.","이미지 모드: 이미지 파일로 저장하며, 자동 모드가 켜져 있으면 바로 삽입합니다.","임베드 모드: 가능하면 텍스트를 추출하고 위치 정보가 있는 참조를 생성합니다. 자동 모드가 꺼져 있으면 결과 복사를 우선합니다."]},{heading:"Canvas",items:["현재 책용 새 Canvas 맵을 만들거나 기존 Canvas를 연결할 수 있습니다.","연결 후 열기, 계속 편집, 연결 해제가 가능하며, 장 맵, 질문 트리, 읽기 경로에 잘 맞습니다."]}]},{title:"자주 쓰는 진입점과 단축키",shortcuts:[{keys:["←","→"],description:"페이지 모드에서 EPUB 보기에 포커스가 있을 때 이전·다음 페이지로 이동합니다(스크롤 모드에서는 화살표 키를 사용하지 않습니다)."},{keys:["←","→","PageUp","PageDown"],description:"단락 읽기 모드에서 단락 패널에 포커스가 있을 때 단락 안 또는 단락 사이를 이동합니다."},{keys:["Esc"],description:"튜토리얼을 닫거나, 현재 포커스된 리더 오버레이를 닫습니다."}],buttons:[{icon:"list",label:"사이드바",description:"목차, 노트, 북마크, 책장 관련 진입점을 전환합니다."},{icon:"a-large-small",label:"타이포그래피",description:"줄 간격, 자간, 페이지 여백 등 읽기 매개변수를 조정합니다."},{icon:"arrow-up-down",label:"읽기 흐름",description:"페이지 모드와 스크롤 읽기를 전환합니다."},{icon:"scroll-text",label:"페이지 레이아웃",description:"단일 페이지와 이단 레이아웃을 전환합니다."},{icon:"bookmark",label:"현재 북마크",description:"현재 페이지 위치를 기록합니다."},{icon:"flag",label:"참조 포인트",description:"읽기 참조 앵커를 저장하거나 업데이트합니다."},{icon:"layout-dashboard",label:"Canvas 맵",description:"읽기 맵을 만들고, 연결하고, 관리합니다."},{icon:"camera",label:"스크린샷 도구",description:"스크린샷 워크플로에 진입합니다."},{icon:"zap",label:"자동 모드",description:"복사 우선과 자동 삽입 출력을 전환합니다."},{icon:"circle-help",label:"튜토리얼",description:"이 튜토리얼을 다시 엽니다."}]}],Fye=[{title:"Weave란",paragraphs:["Weave는 Obsidian용 지식 워크플로 플러그인 모음으로, 「읽기 → 기록 → 일정 → 복습」이라는 장기 학습을 돕습니다.","Weave EPUB Reader(본 플러그인)는 Vault 내 독서와 발췌, Weave 본체는 기억 덱·문제은행·스마트 카드 제작, Weave Incremental Reading은 점진적 읽기 큐와 달력 일정을 담당합니다."],listGroups:[{heading:"세 플러그인의 역할",items:["Weave EPUB Reader: Obsidian 안에서 책을 읽고, 발췌와 하이라이트를 관리하며, 노트·Canvas·덱과 연동합니다.","Weave 본체: Vault 내 임의 파일의 단락에서 출처 링크가 있는 기억 카드를 만들고, 표·칸반·그리드 뷰로 관리·복습합니다.","Weave Incremental Reading: 「나중에 읽을」 내용을 읽기 포인트 큐로 정리하고, 주제와 월 달력으로 여러 책·장의 진행 리듬을 관리합니다."]}]},{title:"Weave EPUB Reader(본 플러그인)",paragraphs:["Obsidian을 노트 창고를 넘어 실제로 책을 읽는 공간으로 만듭니다. Vault에서 EPUB, TXT 등을 열고, 읽으며 발췌하고, 딥 링크와 본문 반영으로 「책 속 문장」과 「Vault 노트」를 연결합니다."],listGroups:[{heading:"핵심 기능",items:["책장과 읽기: 다형식 서재, 목차 이동, 페이지/스크롤, 조판과 테마, 진행률과 북마크.","발췌와 하이라이트: 선택 도구 모음, 5색 하이라이트와 선형 표시, 생각 버블, Markdown / Canvas / Weave 덱 자동·수동 기록.","출처 추적과 재표시: 발췌에 위치 정보 유지; 노트 변경 후 본문 하이라이트 동기화; 하이라이트에서 원본 노트·Canvas·덱 역추적.","확장 워크플로: 장 내보내기, 스크린샷, Canvas 연동, 단락 읽기 모드; Weave 본체의 카드 제작·AI, 점진적 읽기의 장 일정·읽기 포인트 연동.","그 외 다수"]}]},{title:"Weave 본체",paragraphs:["Weave는 Obsidian 기반 지식 카드 시스템입니다. Vault 내 임의 파일의 임의 단락에서 발췌해 출처 추적 링크가 있는 기억 카드를 생성합니다. 모든 카드에 출처 위치 정보를 유지할 수 있어 언제든 원문으로 돌아갈 수 있습니다.","표 뷰, 칸반 뷰, 그리드 카드 뷰로 Weave의 모든 카드와 덱을 탐색·관리할 수 있습니다."],listGroups:[{heading:"핵심 기능",items:["발췌 카드 제작: Markdown, PDF, EPUB 리더, Canvas 등 임의 출처의 단락·선택에서 기억 카드를 만들고 원문으로 돌아가는 출처 링크를 부여합니다.","다중 뷰 관리: 표·칸반·그리드 카드 뷰로 모든 카드와 덱을 탐색·필터·정리합니다.","사이드바 그리드 뷰: 그리드 카드 뷰를 Obsidian 사이드바로 옮기면 현재 활성 Markdown 문서와 관련된 카드만 표시합니다. 활성 문서 기반 AI 카드 제작, 파싱 및 카드 가져오기도 지원합니다.","문제은행과 연습: 문제은행 Markdown을 파싱해 문제를 가져오고 연습 테스트를 시작합니다. 오답 노트·시험 통계도 지원합니다.","간격 반복: FSRS 스케줄링, 학습 세션, 진행 통계, 덱 관리.","그 외 다수"]}]},{title:"Weave Incremental Reading(점진적 읽기 플러그인)",paragraphs:["「저장은 많은데 여러 권을 동시에 열어도 깊게 읽지 못하는」 문제를 다룹니다. Markdown, PDF 선택, Canvas, 웹 페이지, EPUB 장 등의 조각을 일정 가능·이어 읽기 가능·출처 복귀 가능한 읽기 포인트 큐로 정리하고, 의지만으로가 아니라 월 달력으로 밀어갑니다."],listGroups:[{heading:"핵심 기능",items:["읽기 포인트와 주제(IRDeck): 문서 선택, 블록 링크, 리더 선택 텍스트 등에서 읽기 포인트를 만들고 .irdeck 주제로 정리.","점진적 읽기 달력: 대기·예정·기한 지난 포인트를 날짜별로 보고 일일 과제를 계획.","일정과 이어 읽기: 일일 상한, 시간 예산, 교차 읽기 등; 이어 읽기 지점에서 원문 위치로 원클릭 복귀.","출처 복귀: 읽기 포인트에 출처 정보를 유지해 Markdown, PDF, EPUB 등으로 이동.","리더 연동: 본 리더 목차에서 장을 점진적 읽기에 추가; 선택 텍스트로 EPUB 출처 딥 링크 읽기 포인트 생성.","그 외 다수"]}]},{title:"조합해서 쓰는 방법",paragraphs:["세 플러그인은 역할이 나뉘어 있으며 필요에 따라 조합할 수 있습니다. 흔한 구성:"],listGroups:[{items:["Obsidian에서 독서·발췌만: Weave EPUB Reader만으로 충분합니다.","읽은 뒤 복습·카드: EPUB Reader + Weave 본체; 발췌를 카드 창에 채우거나 AI 분할 카드.","여러 권·장편의 리듬: EPUB Reader + Weave Incremental Reading; 장을 달력에 올리고 예정일에 딥 링크로 정독.","전체 루프(읽기 → 기록 → 일정 → 복습): 세 가지 모두; 독서 발췌 → 카드 복습 → 장/단락을 점진적 큐에."]}]}],Rye=[{title:"EPUB 파싱과 읽기 엔진",paragraphs:["EPUB 읽기는 이제 foliate-js 엔진을 완전히 기반으로 하며, 과거 읽기 위치와 기존 데이터는 가능한 한 호환되게 이전됩니다."]},{title:"링크와 지식 캡처",paragraphs:["정확한 EPUB 링크와 원문으로 돌아가는 워크플로는 Obsidian PDF++의 훌륭한 아이디어에서 영감을 받았으며, Obsidian 백링크와 그래프 기능과 결합되었습니다."]},{title:"읽기와 Canvas 연동",paragraphs:["EPUB 리더와 Obsidian Canvas의 연동은 MarginNote 스타일의 읽기와 마인드맵 워크플로에서 영감을 받았으며, Obsidian 네이티브 파일 시스템 안에서 계속 발전하고 있습니다."]},{title:"단락 모드 영감",paragraphs:["단락 읽기 모드는 Readest 읽기 앱의 단락 모드 경험에서 영감을 받아, 이 리더의 위치·발췌·각주 워크플로에 맞게 조정되었습니다."]},{title:"도구 모음 상호작용 참고",paragraphs:["텍스트 선택 도구 모음 상호작용은 WeRead의 읽기 도구 모음 경험에서 영감을 받았습니다."]},{title:"사전 플러그인 호환성",paragraphs:["커뮤니티 제작 Obsidian 플러그인 `obsdian-fingertip-translation`에 감사드립니다. 원래 Obsidian Markdown 편집에 에디터 내 단어 조회를 도입했으며, 호환성 처리 후 이 EPUB 리더 안에서도 작동할 수 있습니다.","리더 자체에는 사전이 포함되어 있지 않습니다. 사전 설명과 관련 팝오버는 해당 외부 플러그인이 제공합니다."],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],Lye={basics:_ye,highlight:Pye,workflow:Mye,tools:Aye,family:Fye,credits:Rye},Bye=[{title:"Открытие и восстановление",paragraphs:["Поместите файл книги в хранилище Obsidian и нажмите на него, чтобы открыть. Читалка автоматически сохраняет и восстанавливает прогресс чтения, настройки типографики и текущее состояние чтения.","Сейчас поддерживаются форматы .epub, .mobi, .azw3, .fb2, .fbz, .txt и .cbz. На практике EPUB, FB2/FBZ и TXT лучше подходят для структурированного экспорта, а CBZ ориентирован на изображения."]},{title:"Боковая панель и книжная полка",paragraphs:["Читалка поддерживает как локальную боковую панель, так и глобальный вид книжной полки, чтобы вы могли переключаться между книгами, оглавлением и аннотациями в одном рабочем пространстве для заметок."],listGroups:[{items:["Оглавление: быстрый переход по главам.","Заметки: просмотр синхронизированных выделений, мыслей и связанного содержимого для текущей книги.","Закладки: управление закладками для текущей страницы.","Моя книжная полка: просмотр файлов книг в хранилище и возврат из подвида книжной полки к боковой панели текущей книги."]}]},{title:"Режимы чтения и макет",listGroups:[{heading:"Поток чтения",items:["Постраничный режим: лучше всего для линейного чтения и перелистывания клавиатурой.","Режим прокрутки: лучше всего для длинных фрагментов, переходов к сноскам и быстрого поиска ближайшего контекста."]},{heading:"Макет страницы",items:["Одна страница: макет по умолчанию для большинства ситуаций.","Две колонки: ближе к ощущению раскрытой книги и автоматически переключается на более широкий экран."]},{heading:"Режим ширины",items:["standard: стандартная ширина чтения для длинного погружённого чтения.","full: более широкий макет с комфортными полями на больших экранах.","edge: настоящий режим от края до края, использующий максимум ширины окна."]}]},{title:"Настройки отображения и вспомогательные функции",paragraphs:["Настройки читалки охватывают не только ширину. Они также включают типографику, сноски и отображение верхней информации, чтобы вы могли настроить опыт под тип книги."],listGroups:[{items:["Панель типографики настраивает межстрочный интервал, межбуквенный интервал и поля страницы, а также может восстановить значения по умолчанию.","В режиме прокрутки можно отдельно включать и выключать кнопки страниц справа.","Верхние стикеры поддерживают макеты auto, inline и right-rail.","Щелчок по маркеру сноски можно переключать между показом всплывающего окна сноски и прямым переходом к сноске."]}]}],Iye=[{title:"Стили аннотаций",paragraphs:["При выделении текста открывается панель инструментов с цветовыми выделениями и несколькими встроенными стилями аннотаций. Цвет, стиль и данные о местоположении сохраняются и восстанавливаются вместе."],colors:[{tone:"yellow",label:"Жёлтый",description:"общая пометка"},{tone:"green",label:"Зелёный",description:"ключевое содержание"},{tone:"blue",label:"Синий",description:"заметки для размышлений"},{tone:"red",label:"Красный",description:"вопросы и сомнения"},{tone:"purple",label:"Фиолетовый",description:"расширенные ассоциации"}],listGroups:[{heading:"Стили",items:["Выделение: лучше всего для стандартных отрывков.","Подчёркивание: сохраняет фон страницы, выделяя ключевые предложения.","Зачёркивание: полезно для содержимого, которое нужно игнорировать, пересмотреть или скрыть.","Волнистое подчёркивание: полезно для проблем, неопределённостей или фрагментов, требующих повторного прочтения."]}]},{title:"Пузыри мыслей и всплывающие сноски",paragraphs:["Пузыри мыслей в тексте — это дополнительные подсказки. Они не заменяют и не ослабляют само выделение, подчёркивание, зачёркивание или волнистое подчёркивание.","Если отрывок содержит разделитель `---div---`, читалка показывает пузырь мысли рядом с выделением. Его можно редактировать из пузыря или через действие «Мысль» на панели инструментов.","Щелчок по маркеру сноски можно настроить на показ всплывающего предпросмотра или прямой переход к месту сноски."]},{title:"Восстановление и синхронизация",listGroups:[{items:["Выделения, стили и мысли автоматически появляются снова при повторном открытии той же книги.","Источники данных последовательно поддерживают Markdown, Canvas и данные карточек, а не полагаются на отдельную закрытую базу данных.","Ссылки на источник — это авторитетная запись для восстановления и поиска отрывков. Пока ссылка действительна, тело отрывка можно свободно переписывать.","При изменении файла заметки читалка перезагружает связанные выделения, чтобы вид книги и вид заметки оставались синхронизированными."]}]}],Dye=[{title:"Как работают автоматические отрывки",paragraphs:["В читалке выделение текста и подсветка отображаются лишь кратко — данные отрывка при этом не сохраняются. Чтобы сохранить отрывок навсегда, создайте или выберите заметку Markdown, Canvas или назначение Weave, укажите место вставки, и читалка автоматически запишет отрывок в выбранное место.","Многие пользователи ошибочно считают, что подсветка сама сохраняет заметку. На практике сначала нужно создать или выбрать целевой файл — только тогда отрывок попадёт в хранилище и сохранится надолго."],listGroups:[{heading:"Сохранение и сводка отрывков",items:["Отрывки чтения хранятся в Markdown, Canvas и карточках Weave; читалка показывает их в сводном виде.","Текст карточки можно свободно редактировать, но не меняйте ссылки на источник — иначе сломается позиционирование и повторное отображение.","Чтобы сохранить навсегда, в панели выделения выберите цель: создать или выбрать Markdown, привязать Canvas или отправить отрывок в Weave."]}]},{title:"Автоматический режим и панель выделения",paragraphs:["Автоматический режим определяет путь вывода по умолчанию после выделения текста: выключенный склоняется к копированию, включённый — к прямой записи в текущий рабочий процесс."],listGroups:[{items:["Автоматический режим выкл.: копирование в буфер обмена для временного цитирования.","Автоматический режим вкл.: лучше для прямой записи в текущий рабочий процесс и также участвует в потоках, связанных с Canvas.","Панель выделения поддерживает копирование или вставку, поиск, создание карточек, точки чтения, действия ИИ и многое другое."]}]},{title:"Формат отрывка и ссылки на источник",paragraphs:["Читалка старается прикреплять точные данные о местоположении к отрывкам, чтобы вы могли вернуться из заметок к исходному фрагменту.","Если отрывок включает мысль, рекомендуется размещать её после разделителя `---div---`, чтобы пузырь мысли автоматически появился в тексте."],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> Excerpt body
> ---div---
> Thought body`},{title:"Закладки и позиции чтения",listGroups:[{items:["Закладка текущей страницы: оставить быструю точку возврата для текущей страницы.","Последняя точка чтения: сохранить недавнее место чтения, которое вы хотите хранить долго.","Опорная точка чтения: записать основной якорь чтения, чтобы вернуться после ответвления.","Точка возобновления инкрементального чтения: работает с инкрементальным чтением как следующая точка входа для обработки."]}]}],Nye=[{title:"Экспорт в Markdown",paragraphs:["Используйте меню вида читалки как точку входа для экспорта, когда хотите превратить результаты чтения в долгосрочные заметки хранилища."],listGroups:[{items:["Экспорт текущей главы: преобразовать текущую главу в Markdown и по возможности сохранить изображения как вложения, удобные для Obsidian.","Экспорт выделений книги: организовать аннотации и отрывки из текущей книги для последующей доработки."]}]},{title:"Скриншоты и интеграция с Canvas",listGroups:[{heading:"Скриншоты",items:["В режиме скриншота можно перетащить область захвата по области просмотра чтения.","Режим изображения: сохранить как файл изображения и вставить напрямую, когда автоматический режим включён.","Режим встраивания: извлечь текст, если возможно, и создать ссылку с учётом местоположения; когда автоматический режим выключен, предпочитает копирование результата."]},{heading:"Canvas",items:["Можно создать новую карту Canvas для текущей книги или привязать существующую Canvas.","После привязки можно открыть, продолжить редактирование или отключить её — это хорошо подходит для карт глав, деревьев вопросов и маршрутов чтения."]}]},{title:"Частые точки входа и сочетания клавиш",shortcuts:[{keys:["←","→"],description:"Когда активен постраничный режим и фокус на виде EPUB, переход на предыдущую или следующую страницу (в режиме прокрутки стрелки не используются)."},{keys:["←","→","PageUp","PageDown"],description:"В режиме чтения по абзацам перемещение внутри или между абзацами, когда фокус на панели абзацев."},{keys:["Esc"],description:"Закрыть руководство или закрыть текущее сфокусированное наложение читалки."}],buttons:[{icon:"list",label:"Боковая панель",description:"Переключение между оглавлением, заметками, закладками и точками входа, связанными с книжной полкой."},{icon:"a-large-small",label:"Типографика",description:"Настройка межстрочного интервала, межбуквенного интервала, полей страницы и других параметров чтения."},{icon:"arrow-up-down",label:"Поток чтения",description:"Переключение между постраничным и прокручиваемым чтением."},{icon:"scroll-text",label:"Макет страницы",description:"Переключение между одностраничным и двухколоночным макетами."},{icon:"bookmark",label:"Текущая закладка",description:"Записать позицию текущей страницы."},{icon:"flag",label:"Опорная точка",description:"Сохранить или обновить якорь опорной точки чтения."},{icon:"layout-dashboard",label:"Карта Canvas",description:"Создать, привязать или управлять картой чтения."},{icon:"camera",label:"Инструмент скриншота",description:"Войти в рабочий процесс скриншота."},{icon:"zap",label:"Автоматический режим",description:"Переключение между приоритетом копирования и автоматической вставкой."},{icon:"circle-help",label:"Руководство",description:"Открыть это руководство снова."}]}],Oye=[{title:"Что такое Weave",paragraphs:["Weave — семейство плагинов Obsidian для долгосрочного обучения: читать → фиксировать → планировать → повторять.","Weave EPUB Reader (этот плагин) отвечает за чтение и выписки в vault; основной Weave — за колоды памяти, банки вопросов и умное создание карточек; Weave Incremental Reading — за очереди точек чтения и календарное планирование."],listGroups:[{heading:"Роли трёх плагинов",items:["Weave EPUB Reader: читать книги в Obsidian, управлять выписками и выделениями, связывать с заметками, Canvas и колодами.","Weave (основной): создавать карточки памяти со ссылками на источник из любого абзаца любого файла vault и управлять ими в табличном, канбан- и сеточном представлениях.","Weave Incremental Reading: собирать «прочитать позже» в очередь точек чтения и вести несколько книг и глав через темы и месячный календарь."]}]},{title:"Weave EPUB Reader (этот плагин)",paragraphs:["Превращает Obsidian не только в архив заметок, но и в место, где вы действительно читаете: открывайте EPUB, TXT и другие книги в vault, делайте выписки по ходу чтения и связывайте фрагменты книги с заметками через глубокие ссылки и отображение в тексте."],listGroups:[{heading:"Основные возможности",items:["Полка и чтение: библиотека разных форматов, оглавление, постраничный/прокручиваемый режим, типографика и темы, прогресс и закладки.","Выписки и выделения: панель выделения, пять цветов и линейные метки, пузыри мыслей, авто- или ручная запись в Markdown, Canvas или колоды Weave.","Трассировка и повторное отображение: выписки сохраняют позицию; выделения обновляются при изменении заметок; обратный переход от выделения к исходной заметке, Canvas или колоде.","Расширенные сценарии: экспорт глав, скриншоты, привязка Canvas, режим чтения по абзацам; создание карточек и AI через основной Weave; планирование глав и точек чтения через инкрементальное чтение.","И многое другое"]}]},{title:"Weave (основной плагин)",paragraphs:["Weave — система карточек знаний на базе Obsidian: выписка из любого абзаца любого файла vault создаёт карточки памяти со ссылками на источник. Каждая карточка может хранить данные о местоположении для возврата к оригиналу.","Просматривайте и управляйте всеми карточками и колодами Weave в табличном, канбан- и сеточном представлениях."],listGroups:[{heading:"Основные возможности",items:["Выписка в карточку: создание карточек памяти из абзацев или выделений в Markdown, PDF, EPUB-читалке, Canvas и других источниках со ссылкой на источник.","Несколько представлений: просмотр, фильтрация и организация всех карточек и колод в таблице, канбане и сетке.","Сетка в боковой панели: при переносе сеточного представления в боковую панель Obsidian можно фильтровать карточки по активному Markdown-файлу; также AI-создание карточек из активного документа, разбор и импорт карточек.","Банк вопросов и практика: разбор Markdown банка вопросов, импорт заданий и запуск тестов; книга ошибок и статистика экзаменов.","Интервальное повторение: планирование FSRS, сессии обучения, статистика прогресса, управление колодами.","И многое другое"]}]},{title:"Weave Incremental Reading",paragraphs:["Для ситуации «много сохранено, но много книг открыто и ни одна не дочитана глубоко»: собирает разрозненный материал из Markdown, PDF, Canvas, веб-страниц и глав EPUB в планируемую, возобновляемую очередь точек чтения с возвратом к источнику — продвижение через календарь, а не только силой воли."],listGroups:[{heading:"Основные возможности",items:["Точки чтения и темы (IRDeck): создание из выделений, блочных ссылок, выделения в читалке и др.; организация в темы .irdeck.","Календарь инкрементального чтения: ожидающие, запланированные и просроченные точки по датам и ежедневные задачи.","Планирование и продолжение: дневные лимиты, бюджет времени, чередование; возврат к точной позиции в источнике одним щелчком.","Возврат к источнику: точки хранят метаданные для перехода в Markdown, PDF, EPUB и др.","Связь с читалкой: добавление глав из оглавления в инкрементальное чтение; точки чтения с глубокими ссылками EPUB из выделенного текста.","И многое другое"]}]},{title:"Как сочетать",paragraphs:["Три плагина разделены по ролям и комбинируются по необходимости. Типичные схемы:"],listGroups:[{items:["Только чтение и выписки в Obsidian: достаточно Weave EPUB Reader.","Повторение и карточки после чтения: EPUB Reader + основной Weave — выписки в окно карточки или AI-разбиение.","Ритм для нескольких или длинных книг: EPUB Reader + Weave Incremental Reading — главы в календаре и возврат по глубокой ссылке в день задачи.","Полный цикл (читать → фиксировать → планировать → повторять): все три — выписки при чтении, карточки для повторения, главы и абзацы в очередь инкрементального чтения."]}]}],zye=[{title:"Разбор EPUB и движок чтения",paragraphs:["Чтение EPUB теперь полностью основано на движке foliate-js, а исторические позиции чтения и существующие данные переносятся с максимально возможной совместимостью."]},{title:"Ссылки и захват знаний",paragraphs:["Точная ссылка на EPUB и рабочий процесс возврата к источнику были вдохновлены отличными идеями Obsidian PDF++ и объединены с возможностями обратных ссылок и графа Obsidian."]},{title:"Интеграция чтения и Canvas",paragraphs:["Интеграция между читалкой EPUB и Obsidian Canvas была вдохновлена рабочими процессами чтения и ментальных карт в стиле MarginNote и продолжает развиваться в рамках нативной файловой системы Obsidian."]},{title:"Вдохновение для режима абзацев",paragraphs:["Режим чтения по абзацам был вдохновлён опытом режима абзацев в приложении Readest и адаптирован под рабочие процессы местоположения, отрывков и сносок этой читалки."]},{title:"Справка по взаимодействию с панелью инструментов",paragraphs:["Взаимодействие с панелью инструментов выделения текста черпает вдохновение из опыта панели чтения в WeRead."]},{title:"Совместимость со словарным плагином",paragraphs:["Благодарим сообщество за плагин Obsidian `obsdian-fingertip-translation`. Изначально он принёс поиск слов прямо в редактор Obsidian Markdown и теперь после обработки совместимости может работать и внутри этой читалки EPUB.","Сама читалка не включает словарь. Пояснения словаря и связанные всплывающие окна предоставляет этот внешний плагин."],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],Uye={basics:Bye,highlight:Iye,workflow:Dye,tools:Nye,family:Oye,credits:zye},Vye=[{title:"Öffnen und wiederherstellen",paragraphs:["Legen Sie eine Buchdatei in IhrObsidian vaultund klicken Sie darauf, um es zu öffnen. Der Reader speichert automatisch den Lesefortschritt, die Typografieeinstellungen und den aktuellen Lesestatus und stellt ihn wieder her.","Derzeit unterstützte Formate sind .epub, .mobi, .azw3, .fb2, .fbz, .txt und .cbz. In der Praxis,EPUB, FB2/FBZ, UndTXTeignen sich besser für den strukturierten ExportCBZist eher bildorientiert."]},{title:"Seitenleiste und Bücherregal",paragraphs:["Der Reader unterstützt sowohl eine lokale Seitenleiste als auch eine globale Bücherregalansicht, sodass Sie innerhalb desselben Notizarbeitsbereichs zwischen Büchern, dem Inhaltsverzeichnis und Anmerkungen wechseln können."],listGroups:[{items:["TOC:Springen Sie schnell zum Kapitel.","Notes:Überprüfen Sie synchronisierte Highlights, Gedanken und verwandte Inhalte für das aktuelle Buch.","Bookmarks:Verwalten Sie Lesezeichen für die aktuelle Seite.","My Bookshelf: Buchdateien im Tresor durchsuchen und von der Bücherregal-Unteransicht zur aktuellen Buchseitenleiste zurückkehren."]}]},{title:"Lesemodi und Layout",listGroups:[{heading:"Lesefluss",items:["Paged mode: am besten für lineares Lesen und Umblättern auf der Tastatur geeignet.","Scrolled mode: am besten für längere Passagen, Fußnotenrundläufe und die schnelle Suche nach Kontext in der Nähe."]},{heading:"Seitenlayout",items:["Einzelne Seite: das Standardlayout für die meisten Situationen.","Doppelspaltig: nähert sich dem Gefühl eines offenen Buches und wechselt automatisch zu einer breiteren Anzeige."]},{heading:"Breitenmodus",items:["standard: standardLesebreite für immersives Lesen in Langform.","full: ein breiteres Layout, das auf größeren Bildschirmen immer noch komfortable Ränder bietet.","edge: eine wahreedge-Zu-edgeModus, der möglichst viel Hostbreite nutzt."]}]},{title:"Anzeigeeinstellungen und Helfer",paragraphs:["Die Reader-Einstellungen decken mehr als nur die Breite ab. Sie umfassen außerdem Typografie, Fußnoten und eine Top-Informationsanzeige, sodass Sie das Erlebnis je nach Buchtyp abstimmen können."],listGroups:[{items:["Das Typografie-Bedienfeld passt die Zeilenhöhe, den Buchstabenabstand und die Seitenränder an und kann die Standardeinstellungen wiederherstellen.","Scrolled modeSie können die Seitenschaltflächen auf der rechten Seite unabhängig voneinander umschalten.","Durch Klicken auf die Fußnotenmarkierung kann zwischen der Anzeige eines Fußnoten-Popovers und dem direkten Springen zur Fußnote umgeschaltet werden."]}]}],Hye=[{title:"Anmerkungsstile",paragraphs:["Durch Auswählen von Text wird die Symbolleiste geöffnet und Farbhervorhebungen sowie mehrere Inline-Anmerkungsstile werden unterstützt. Farb-, Stil- und Standortdaten werden alle zusammen gespeichert und wiederhergestellt."],colors:[{tone:"yellow",label:"Gelb",description:"allgemeine Kennzeichnung"},{tone:"green",label:"Grün",description:"Schlüsselinhalte"},{tone:"blue",label:"Blau",description:"Denknotizen"},{tone:"red",label:"Rot",description:"Fragen und Zweifel"},{tone:"purple",label:"Lila",description:"erweiterte Assoziationen"}],listGroups:[{heading:"Stile",items:["Highlight: am besten fürstandardAuszüge.","Unterstreichen: Behält den Seitenhintergrund bei und betont gleichzeitig wichtige Sätze.","Durchgestrichen: nützlich für Inhalte, die ignoriert, überarbeitet oder ausgeblendet werden sollen.","Wellenförmige Unterstreichung: nützlich bei Problemen, Unsicherheiten oder Passagen, die einen weiteren Durchgang erfordern."]}]},{title:"Gedankenblasen und Fußnoten-Popovers",paragraphs:["Gedankenblasen im Text sind zusätzliche Hinweise. Sie ersetzen oder schwächen die Hervorhebung, Unterstreichung, Durchstreichung oder Wellenunterstreichung selbst nicht ab.","Solange der Auszug ein ` enthält---div---` Trennzeichen, der Leser zeigt neben der Hervorhebung eine Gedankenblase an. Sie können es über die Sprechblase oder über die Gedankenaktion in der Symbolleiste bearbeiten.","Klicks auf Fußnotenmarkierungen können so konfiguriert werden, dass eine Popover-Vorschau angezeigt wird oder direkt zur Fußnotenposition gesprungen wird."]},{title:"Wiederherstellen und synchronisieren",listGroups:[{items:["Markierungen, Stile und Gedanken werden automatisch wieder angezeigt, wenn Sie dasselbe Buch erneut öffnen.","Datenquellen unterstützen durchwegMarkdown, Canvasund Kartendaten, anstatt sich auf eine separate Black-Box-Datenbank zu verlassen.","Quelllinks sind der maßgebliche Datensatz zum Wiederherstellen und Auffinden von Auszügen. Solange der Link gültig bleibt, können Sie den Auszugstext frei umschreiben.","Wenn sich eine Notizdatei ändert, lädt der Leser die zugehörigen Markierungen neu, sodass die Buchansicht und die Notizansicht synchron bleiben."]}]}],$ye=[{title:"So funktionieren automatisierte Auszüge",paragraphs:["Im Reader wird das Auswählen von Text und Hervorheben nur kurz angezeigt – es werden keine Auszugsdaten gespeichert. Um Auszüge dauerhaft aufzubewahren, erstellen oder wählen Sie eine ausMarkdownNotiz,Canvas, oderWeaveGeben Sie das Ziel ein, wählen Sie die Stelle aus, an der es eingefügt werden soll, und der Leser schreibt automatisch an diese Stelle.","Viele Benutzer erwarten, dass allein durch Hervorheben eine Notiz gespeichert wird. In der Praxis müssen Sie zunächst eine Zieldatei erstellen oder auswählen; Erst dann wird der Auszug zur langfristigen Speicherung in Ihren Tresor geschrieben."],listGroups:[{heading:"Auszüge speichern und aggregieren",items:["Leseauszüge live inMarkdown, Canvas, UndWeaveKarten; Der Leser fasst sie an einem Ort zusammen.","Sie können den Text des Kartenkörpers frei bearbeiten, aber die Quelllinks nicht ändern – dadurch wird die Position beeinträchtigt und die Anzeige erneut angezeigt.","Um dauerhaft zu speichern, verwenden Sie die Auswahlsymbolleiste, um ein Ziel auszuwählen: Erstellen oder AuswählenMarkdown, bindenCanvas, oder Auszug dazuWeave."]}]},{title:"Auto-Modus und die Auswahlsymbolleiste",paragraphs:["Der Auto-Modus bestimmt den Standardausgabepfad nach der Auswahl von Text: „Aus“ tendiert zum Kopieren, während „Ein“ dazu tendiert, direkt in Ihren aktuellen Workflow zu schreiben."],listGroups:[{items:["Automatischer Modus aus: Zur temporären Angebotserstellung in die Zwischenablage kopieren.","Auto-Modus an: besser zum direkten Schreiben in den aktuellen Workflow und auch Teilnahme daranCanvas-verknüpfte Flüsse.","Die Auswahlsymbolleiste unterstützt Kopieren oder Einfügen, Suchen, Kartenerstellung, Lesepunkte, KI-Aktionen und mehr."]}]},{title:"Auszugsformat und Quellenlinks",paragraphs:["Der Leser versucht, den Auszügen genaue Ortsangaben beizufügen, sodass Sie von den Notizen zur Originalpassage zurückspringen können.","Wenn ein Auszug einen Gedanken enthält, platzieren Sie ihn nach dem „---div---` Trennzeichen wird empfohlen, damit die Gedankenblase automatisch im Text erscheint."],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> Excerpt body
> ---div---
> Thought body`},{title:"Lesezeichen und Lesepositionen",listGroups:[{items:["Lesezeichen für aktuelle Seite: Hinterlassen Sie einen schnellen Rückkehrpunkt zur aktuellen Seite.","Letzter Lesepunkt: Speichern Sie den letzten Leseort, den Sie langfristig behalten möchten.","Lesereferenzpunkt: Zeichnen Sie einen Hauptleseanker auf, damit Sie nach der Verzweigung zurückkehren können.","Wiederaufnahmepunkt für inkrementelles Lesen: Arbeiten Sie mit inkrementellem Lesen als nächstem Einstiegspunkt für die Verarbeitung."]}]}],Wye=[{title:"Exportieren nachMarkdown",paragraphs:["Verwenden Sie das Menü „Leseransicht“ als Exporteinstiegspunkt, wenn Sie die Leseausgabe in langfristige Tresornotizen umwandeln möchten."],listGroups:[{items:["Aktuelles Kapitel exportieren: Konvertieren Sie das aktuelle Kapitel inMarkdownund Bilder behalten alsObsidian-freundliche Anhängsel wann immer möglich.","Buch-Highlights exportieren: Anmerkungen und Auszüge aus dem aktuellen Buch zur späteren Verfeinerung organisieren."]}]},{title:"Screenshots undCanvasIntegration",listGroups:[{heading:"Screenshots",items:["Im Screenshot-Modus können Sie einen Aufnahmebereich über das Leseansichtsfenster ziehen.","Bildmodus: Als Bilddatei speichern und direkt einfügen, wenn der Automatikmodus aktiviert ist.","Einbettungsmodus: Extrahieren Sie nach Möglichkeit Text und generieren Sie eine standortbezogene Referenz. Wenn der Automatikmodus ausgeschaltet ist, wird das Ergebnis lieber kopiert."]},{heading:"Canvas",items:["Sie können ein neues erstellenCanvasKarte für das aktuelle Buch oder binden Sie ein vorhandenesCanvas.","Nach dem Binden können Sie es öffnen, weiter bearbeiten oder trennen, was für Kapitelkarten, Fragenbäume und Leserouten gut funktioniert."]}]},{title:"Allgemeine Einstiegspunkte und Verknüpfungen",shortcuts:[{keys:["←","→"],description:"Wenn der Seitenmodus aktiv ist und dieEPUBWenn die Ansicht fokussiert ist, wechseln Sie zur vorherigen oder nächsten Seite (im Scrollmodus werden keine Pfeiltasten verwendet)."},{keys:["←","→","PageUp","PageDown"],description:"Bewegen Sie sich im Absatzlesemodus innerhalb oder zwischen Absätzen, wenn das Absatzfenster fokussiert ist."},{keys:["Esc"],description:"Schließen Sie das Tutorial oder schließen Sie das aktuell fokussierte Leser-Overlay."}],buttons:[{icon:"list",label:"Seitenleiste",description:"Wechseln Sie zwischen Inhaltsverzeichnis, Notizen, Lesezeichen und bücherregalbezogenen Einstiegspunkten."},{icon:"a-large-small",label:"Typografie",description:"Passen Sie Zeilenhöhe, Buchstabenabstand, Seitenränder und andere Leseparameter an."},{icon:"arrow-up-down",label:"Lesefluss",description:"Wechseln Sie zwischen seitenweiser und gescrollter Lektüre."},{icon:"scroll-text",label:"Seitenlayout",description:"Wechseln Sie zwischen einseitigen und zweispaltigen Layouts."},{icon:"bookmark",label:"Aktuelles Lesezeichen",description:"Notieren Sie die aktuelle Seitenposition."},{icon:"flag",label:"Referenzpunkt",description:"Speichern oder aktualisieren Sie den Lesereferenzanker."},{icon:"layout-dashboard",label:"CanvasKarte",description:"Erstellen, binden oder verwalten Sie die Lesekarte."},{icon:"camera",label:"Screenshot-Tool",description:"Rufen Sie den Screenshot-Workflow auf."},{icon:"zap",label:"Auto-Modus",description:"Wechseln Sie zwischen der Ausgabe „Zuerst kopieren“ und der automatischen Einfügung."},{icon:"circle-help",label:"Anleitung",description:"Öffnen Sie dieses Tutorial erneut."}]}],jye=[{title:"Was istWeave",paragraphs:["Weaveist eine Familie vonObsidianPlugins, die auf langfristiges Lernen ausgerichtet sind: Lesen → Erfassen → Planen → Überprüfen.","Weave EPUBReader (dieses Plugin) übernimmt das Lesen und Auszüge im Tresor; DieWeaveDas Haupt-Plugin verwaltet Speicherdecks, Fragendatenbanken und die Erstellung von Smartcards.WeaveInkrementelles Lesen verwaltet Lesepunktwarteschlangen und Kalenderplanung."],listGroups:[{heading:"Wie die drei Plugins funktionieren",items:["Weave EPUBLeser: Bücher einlesenObsidian, Hervorhebungen und Auszüge verwalten und mit Notizen verknüpfen,Canvas, und Decks.","WeaveHaupt-Plugin: Erstellen Sie Speicherkarten mit Quelllinks aus jedem Absatz in jeder Tresordatei und verwalten und überprüfen Sie sie in Tabellen-, Kanban- und Rasteransichten.","WeaveInkrementelles Lesen: Organisieren Sie „Später gelesenes“ Material in Lesepunktwarteschlangen und blättern Sie mehrere Bücher und Kapitel durch Themen und einen Monatskalender weiter."]}]},{title:"Weave EPUBReader (dieses Plugin)",paragraphs:["MachenObsidianmehr als ein Notizarchiv – ein Ort, an dem man tatsächlich liest: offenEPUB, TXT, und andere Bücher in Ihrem Tresor, erstellen Sie unterwegs Auszüge und verknüpfen Sie Passagen über Deep Links und In-Body-Rendering mit Ihren Notizen."],listGroups:[{heading:"Kernkompetenzen",items:["Bücherregal und Lesen: Multiformat-Bibliothek, Inhaltsverzeichnis-Navigation, Seiten-/Bildlaufmodi, Typografie und Themen, Fortschritt und Lesezeichen.","Auszüge und Hervorhebungen: Auswahlsymbolleiste, fünf Hervorhebungsfarben und lineare Markierungsstile, Gedankenblasen, automatische oder manuelle ErfassungMarkdown, Canvas, oderWeaveDecks.","Nachverfolgung und erneute Anzeige: Auszüge bewahren Standortdaten auf; Hervorhebungen werden aktualisiert, wenn sich Notizen ändern; von einem Highlight zurück zur Quellnotiz springen,Canvas, oder Deck.","Erweiterte Arbeitsabläufe: Kapitelexport, Screenshots,CanvasBindung, Absatzlesemodus; Kartenerstellung und KI über dieWeaveHaupt-Plugin; Kapitelplanung und Lesepunkte durch inkrementelles Lesen.","Und mehr"]}]},{title:"WeaveHaupt-Plugin",paragraphs:["Weaveist einObsidian-basiertes WissenedgeKartensystem: Extrahieren Sie einen beliebigen Absatz aus einer beliebigen Datei in Ihrem Tresor, um Speicherkarten mit Links zur Quellenverfolgung zu erstellen. Jede Karte kann Standortmetadaten speichern, sodass Sie zur ursprünglichen Passage zurückkehren können.","Durchsuchen und verwalten Sie alleWeaveKarten und Stapel in der Tabellenansicht, Kanban-Ansicht und Rasterkartenansicht."],listGroups:[{heading:"Kernkompetenzen",items:["Auszug auf Karte: Erstellen Sie Speicherkarten aus Absätzen oder Auswahlen inMarkdown, PDF, dieEPUBLeser,Canvasund andere Quellen, jeweils mit einem Link zurück zur Quelle.","Verwaltung mehrerer Ansichten: Durchsuchen, filtern und organisieren Sie alle Karten und Decks in Tabellen-, Kanban- und Rasterkartenansichten.","Rasteransicht der Seitenleiste: Docken Sie die Rasterkartenansicht anObsidians Seitenleiste, um Karten nach den aktuell aktiven Karten zu filternMarkdownDatei; Unterstützt auch die Erstellung von AI-Karten aus dem aktiven Dokument sowie das Parsen und Importieren von Karten.","Fragenbank und Übung: Fragenbank analysierenMarkdownDateien importieren, Fragen importieren und Übungstests starten; Enthält Fehlerbuch und Prüfungsstatistiken.","Abstandswiederholung: FSRS-Planung, Lernsitzungen, Fortschrittsstatistiken und Deckverwaltung.","Und mehr"]}]},{title:"WeaveInkrementelles Lesen",paragraphs:["Wenn Sie viel sparen, aber nicht viele Bücher gründlich durchlesen, sollten Sie verstreutes Material ausschaltenMarkdown, PDF-Auswahl,Canvas, Webseiten undEPUBKapitel in eine planbare, wiederaufnehmbare, mit der Quelle verknüpfte Lesepunktwarteschlange – vorangetrieben durch einen Kalender statt nur durch Willenskraft."],listGroups:[{heading:"Kernkompetenzen",items:["Lesepunkte und -themen (IRDeck): Erstellen Sie Punkte aus Dokumentauswahlen, Blocklinks, Leserauswahlen und mehr; Organisieren Sie sie in .irdeck-Themen.","Inkrementeller Lesekalender: Sehen Sie sich ausstehende, geplante und überfällige Punkte nach Datum an und planen Sie tägliche Leseaufgaben.","Planen und Fortsetzen: Tageslimits, Zeitbudgets, verschachteltes Lesen und Rückkehr mit einem Klick zur genauen Ausgangsposition.","Rücksprung zur Quelle: Lesepunkte behalten die Metadaten der Quelle, sodass Sie zu ihnen zurückkehren könnenMarkdown, PDF,EPUBund andere Ursprünge.","Reader-Integration: Kapitel aus dem Inhaltsverzeichnis dieses Readers zum inkrementellen Lesen hinzufügen; Lesepunkte schaffen mitEPUBQuell-Deep-Links aus ausgewähltem Text.","Und mehr"]}]},{title:"Wie man sie kombiniert",paragraphs:["Die drei Plugins haben unterschiedliche Rollen und können je nach Bedarf gemischt werden. Gängige Setups:"],listGroups:[{items:["Lesen und Auszug nur inObsidian: Weave EPUBDer Reader allein reicht aus.","Gehen Sie nach dem Lesen noch einmal durch und erstellen Sie Karten:EPUBLeser +WeaveHaupt-Plugin – Füllen Sie das Kartenfenster aus Auszügen oder verwenden Sie AI-Split-to-Card.","Tempo für mehrere oder lange Bücher:EPUBLeser +WeaveInkrementelles Lesen – Planen Sie Kapitel im Kalender und verlinken Sie sie an bestimmten Tagen per Deep-Link.","Vollständige Schleife (Lesen → Erfassen → Planen → Überprüfen): Installieren Sie alle drei – Auszug beim Lesen, Überprüfen mit Karten, Warteschlange für Kapitel und Passagen zum schrittweisen Lesen."]}]}],qye=[{title:"EPUBParsing- und Lese-Engine",paragraphs:["EPUBLesen ist jetztfully basierend auf demfoliate-jsDabei werden historische Lesepositionen und vorhandene Daten möglichst kompatibel migriert."]},{title:"Links und Wissenedgeerfassen",paragraphs:["Das PräziseEPUBDer Link- und Jump-Back-Workflow wurde von den hervorragenden Ideen dahinter inspiriertObsidian PDF++und kombiniert mitObsidianBacklinks und Diagrammfunktionen."]},{title:"Lesen undCanvasIntegration",paragraphs:["Die Integration zwischenEPUBLeser undObsidian Canvaswurde inspiriert vonMarginNoteLese- und Mindmap-Arbeitsabläufe im Stil von Lese- und Mindmaps und entwickeln sich gleichzeitig weiterObsidians natives Dateisystem."]},{title:"Inspiration für den Absatzmodus",paragraphs:["Der Absatzlesemodus wurde von der Erfahrung im Absatzmodus im inspiriertReadestLese-App erstellt und dann an den Standort, den Auszug und die Fußnoten-Workflows dieses Lesers angepasst."]},{title:"Referenz zur Symbolleisteninteraktion",paragraphs:["Die Interaktion mit der Textauswahl-Symbolleiste ist von der Lese-Symbolleiste in inspiriertWeRead."]},{title:"Kompatibilität mit Wörterbuch-Plugins",paragraphs:["Dank der Community-errichtetObsidianPlugin`obsdian-fingertip-translation`. Ursprünglich wurde die Wortsuche im Editor unterstütztObsidian Markdownbearbeiten und kann nun auch darin arbeitenEPUBLeser nach Kompatibilitätsbehandlung.","Der Reader selbst bündelt kein Wörterbuch. Wörterbucherklärungen und zugehörige Popovers werden von diesem externen Plugin bereitgestellt."],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],Kye={basics:Vye,highlight:Hye,workflow:$ye,tools:Wye,family:jye,credits:qye},Gye=[{title:"Abrir y restaurar",paragraphs:["Coloque un archivo de libro en suObsidian vaulty haga clic en él para abrir. El lector guarda y restaura automáticamente el progreso de la lectura, las preferencias de tipografía y el estado de lectura actual.","Los formatos admitidos actualmente son .epub, .mobi, .azw3, .fb2, .fbz, .txt y .cbz. En la práctica,EPUB, FB2/FBZ, yTXTson mejores para la exportación estructurada, mientras queCBZestá más orientado a la imagen."]},{title:"Barra lateral y estantería",paragraphs:["El lector admite tanto una barra lateral local como una vista de estantería global para que pueda alternar entre libros, el índice y las anotaciones dentro del mismo espacio de trabajo para tomar notas."],listGroups:[{items:["TOC:saltar rápidamente por capítulo.","Notes:revise lo más destacado, los pensamientos y el contenido relacionado sincronizados para el libro actual.","Bookmarks:administrar marcadores para la página actual.","My Bookshelf: explora los archivos de libros en la bóveda y regresa desde la subvista de la estantería a la barra lateral del libro actual."]}]},{title:"Modos de lectura y diseño.",listGroups:[{heading:"Flujo de lectura",items:["Paged mode: mejor para lectura lineal y cambios de página con el teclado.","Scrolled mode: mejor para pasajes más largos, ida y vuelta de notas a pie de página y búsqueda rápida de contexto cercano."]},{heading:"Diseño de página",items:["Página única: el diseño predeterminado para la mayoría de situaciones.","Doble columna: más parecida a la sensación de un libro abierto y cambia automáticamente a una pantalla más amplia."]},{heading:"Modo ancho",items:["standard: standardancho de lectura para una lectura inmersiva de larga duración.","full: un diseño más amplio que aún mantiene márgenes cómodos en pantallas más grandes.","edge: un verdaderoedge-a-edgemodo que utiliza tanto ancho de host como sea posible."]}]},{title:"Configuración de pantalla y ayudantes",paragraphs:["La configuración del lector cubre más que el ancho. También incluyen tipografía, notas a pie de página y visualización de información superior para que puedas ajustar la experiencia por tipo de libro."],listGroups:[{items:["El panel de tipografía ajusta la altura de las líneas, el espaciado entre letras y los márgenes de la página, y puede restaurar los valores predeterminados.","Scrolled modePuede alternar de forma independiente los botones de la página del lado derecho.","Los clics en el marcador de nota al pie pueden alternar entre mostrar una ventana emergente de nota al pie y saltar directamente a la nota al pie."]}]}],Zye=[{title:"Estilos de anotación",paragraphs:["Al seleccionar texto, se abre la barra de herramientas y admite resaltados de color además de múltiples estilos de anotación en línea. Los datos de color, estilo y ubicación se guardan y restauran juntos."],colors:[{tone:"yellow",label:"Amarillo",description:"marcado general"},{tone:"green",label:"Verde",description:"contenido clave"},{tone:"blue",label:"Azul",description:"notas de pensamiento"},{tone:"red",label:"Rojo",description:"preguntas y dudas"},{tone:"purple",label:"Púrpura",description:"asociaciones extendidas"}],listGroups:[{heading:"Estilos",items:["Destacado: mejor parastandardextractos.","Subrayado: mantiene el fondo de la página mientras enfatiza las oraciones clave.","Tachado: útil para ignorar, revisar u ocultar contenido.","Subrayado ondulado: útil para problemas, incertidumbres o pasajes que necesitan otra pasada."]}]},{title:"Burbujas de pensamiento y ventanas emergentes de notas al pie",paragraphs:["Las burbujas de pensamiento en el texto son señales adicionales. No reemplazan ni debilitan el resaltado, el subrayado, el tachado o el subrayado ondulado.","Siempre que el extracto contenga un `---div---` separador, el lector muestra una burbuja de pensamiento al lado del resaltado. Puedes editarlo desde la burbuja o desde la acción de pensamiento de la barra de herramientas.","Los clics en los marcadores de notas al pie se pueden configurar para mostrar una vista previa emergente o saltar directamente a la ubicación de la nota al pie."]},{title:"Restaurar y sincronizar",listGroups:[{items:["Los aspectos más destacados, los estilos y los pensamientos reaparecen automáticamente cuando vuelves a abrir el mismo libro.","Las fuentes de datos respaldan constantementeMarkdown, Canvasy datos de tarjetas en lugar de depender de una base de datos de caja negra separada.","Los enlaces de origen son el registro autorizado para restaurar y localizar extractos. Mientras el enlace siga siendo válido, puedes reescribir libremente el cuerpo del extracto.","Cuando un archivo de notas cambia, el lector recarga los aspectos destacados relacionados para que la vista del libro y la vista de notas permanezcan sincronizadas."]}]}],Xye=[{title:"Cómo funcionan los extractos automatizados",paragraphs:["En el lector, la selección de texto y el resaltado solo se muestran brevemente; no guarda datos de extractos. Para conservar extractos de forma permanente, cree o elija unMarkdownnota,Canvas, oWeavedestino, elija dónde insertar y el lector escribirá en esa ubicación automáticamente.","Muchos usuarios esperan resaltar solo para guardar una nota. En la práctica, primero debes crear o elegir un archivo de destino; sólo entonces se escribe el extracto en su bóveda para su almacenamiento a largo plazo."],listGroups:[{heading:"Guardar y agregar extractos",items:["Extractos de lectura en vivo enMarkdown, Canvas, yWeavetarjetas; el lector los agrega en un solo lugar.","Puede editar el texto del cuerpo de la tarjeta libremente, pero no cambie los enlaces de origen, ya que eso altera la ubicación y se vuelve a mostrar.","Para guardar permanentemente, use la barra de herramientas de selección para elegir un objetivo: crear o elegirMarkdown, unirCanvas, o extracto deWeave."]}]},{title:"Modo automático y barra de herramientas de selección.",paragraphs:["El modo automático decide la ruta de salida predeterminada después de seleccionar el texto: desactivado se inclina hacia la copia, mientras que activado se inclina hacia la escritura directamente en su flujo de trabajo actual."],listGroups:[{items:["Modo automático desactivado: copiar al portapapeles para cotizaciones temporales.","Modo automático activado: mejor para escribir directamente en el flujo de trabajo actual y también participa enCanvas-flujos vinculados.","La barra de herramientas de selección admite copiar o insertar, buscar, crear tarjetas, leer puntos, acciones de IA y más."]}]},{title:"Formato de extracto y enlaces de origen",paragraphs:["El lector intenta adjuntar datos de ubicación precisos a los extractos para que pueda retroceder de las notas al pasaje original.",'Si un extracto incluye un pensamiento, colóquelo después de "---div---Se recomienda el separador `para que la burbuja de pensamiento pueda aparecer en el texto automáticamente.'],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> Excerpt body
> ---div---
> Thought body`},{title:"Marcadores y posiciones de lectura.",listGroups:[{items:["Marcador de página actual: deja un punto de retorno rápido para la página actual.","Último punto de lectura: guarde la ubicación de lectura reciente que desea conservar a largo plazo.","Punto de referencia de lectura: registre un ancla de lectura principal para que pueda regresar después de diversificarse.","Punto de reanudación de lectura incremental: trabaje con la lectura incremental como el siguiente punto de entrada para el procesamiento."]}]}],Yye=[{title:"Exportar aMarkdown",paragraphs:["Utilice el menú de vista del lector como punto de entrada de exportación cuando desee convertir la salida de lectura en notas de bóveda a largo plazo."],listGroups:[{items:["Exportar capítulo actual: convierte el capítulo actual aMarkdowny mantener las imágenes comoObsidian-Adjuntos amigables siempre que sea posible.","Exportar aspectos destacados del libro: organice anotaciones y extractos del libro actual para perfeccionarlos más adelante."]}]},{title:"Capturas de pantalla yCanvasintegración",listGroups:[{heading:"Capturas de pantalla",items:["En el modo de captura de pantalla, puede arrastrar un área de captura sobre la ventana de lectura.","Modo de imagen: guárdelo como un archivo de imagen e insértelo directamente cuando el modo automático esté activado.","Modo de inserción: extraiga texto cuando sea posible y genere una referencia con reconocimiento de ubicación; cuando el modo automático está desactivado, prefiere copiar el resultado."]},{heading:"Canvas",items:["Puedes crear un nuevoCanvasmapa para el libro actual o enlazar uno existenteCanvas.","Después de vincularlo, puede abrirlo, seguir editándolo o desconectarlo, lo que funciona bien para mapas de capítulos, árboles de preguntas y rutas de lectura."]}]},{title:"Puntos de entrada y atajos comunes",shortcuts:[{keys:["←","→"],description:"Cuando el modo paginado está activo y elEPUBLa vista está enfocada, vaya a la página anterior o siguiente (el modo de desplazamiento no utiliza teclas de flecha)."},{keys:["←","→","PageUp","PageDown"],description:"En el modo de lectura de párrafos, muévase dentro o entre párrafos cuando el panel de párrafos esté enfocado."},{keys:["Esc"],description:"Cierre el tutorial o descarte la superposición del lector actualmente enfocado."}],buttons:[{icon:"list",label:"Barra lateral",description:"Cambie entre TOC, notas, marcadores y puntos de entrada relacionados con estanterías."},{icon:"a-large-small",label:"Tipografía",description:"Ajuste la altura de la línea, el espaciado entre letras, los márgenes de la página y otros parámetros de lectura."},{icon:"arrow-up-down",label:"Flujo de lectura",description:"Cambie entre lectura paginada y desplazada."},{icon:"scroll-text",label:"Diseño de página",description:"Cambie entre diseños de una sola página y de dos columnas."},{icon:"bookmark",label:"Marcador actual",description:"Registre la posición actual de la página."},{icon:"flag",label:"Punto de referencia",description:"Guarde o actualice el ancla de referencia de lectura."},{icon:"layout-dashboard",label:"Canvasmapa",description:"Cree, vincule o administre el mapa de lectura."},{icon:"camera",label:"Herramienta de captura de pantalla",description:"Ingrese al flujo de trabajo de captura de pantalla."},{icon:"zap",label:"Modo automático",description:"Cambie entre salida de copia primero e inserción automática."},{icon:"circle-help",label:"Tutorial",description:"Abre este tutorial nuevamente."}]}],Jye=[{title:"Qué esWeave",paragraphs:["Weavees una familia deObsidiancomplementos creados en torno al aprendizaje a largo plazo: leer → capturar → programar → revisar.","Weave EPUBReader (este complemento) maneja la lectura y los extractos en la bóveda; elWeaveEl complemento principal maneja conjuntos de memoria, bancos de preguntas y creación de tarjetas inteligentes;WeaveLa lectura incremental maneja las colas de puntos de lectura y la programación del calendario."],listGroups:[{heading:"Cómo dividen el trabajo los tres complementos",items:["Weave EPUBLector: leer libros enObsidian, gestionar aspectos destacados y extractos, y conectarse con notas,Canvasy cubiertas.","WeaveComplemento principal: cree tarjetas de memoria con enlaces de origen de cualquier párrafo en cualquier archivo de bóveda, y adminístrelas y revíselas en vistas de tabla, kanban y cuadrícula.",'WeaveLectura incremental: organice el material para "leer más tarde" en colas de puntos de lectura y avance varios libros y capítulos a través de temas y un calendario mensual.']}]},{title:"Weave EPUBLector (este complemento)",paragraphs:["HacerObsidianmás que un archivo de notas: un lugar donde realmente lees: abrirEPUB, TXTy otros libros en su bóveda, extraiga extractos a medida que avanza y mantenga los pasajes vinculados a sus notas a través de enlaces profundos y renderizado en el cuerpo."],listGroups:[{heading:"Capacidades principales",items:["Estantería y lectura: biblioteca multiformato, navegación TOC, modos paginados/desplazados, tipografía y temas, progreso y marcadores.","Extractos y aspectos destacados: barra de herramientas de selección, cinco colores de resaltado y estilos de marcas lineales, burbujas de pensamiento, captura automática o manual deMarkdown, Canvas, oWeavecubiertas.","Seguimiento y revisualización: los extractos conservan los datos de ubicación; los aspectos destacados se actualizan cuando cambian las notas; saltar de un resaltado a la nota fuente,Canvas, o cubierta.","Flujos de trabajo extendidos: exportación de capítulos, capturas de pantalla,Canvasencuadernación, modo de lectura de párrafos; creación de tarjetas e IA a través delWeavecomplemento principal; programación de capítulos y puntos de lectura mediante lectura incremental.","y mas"]}]},{title:"Weavecomplemento principal",paragraphs:["Weavees unObsidianconocimiento basado enedgeSistema de tarjetas: extraiga cualquier párrafo de cualquier archivo en su bóveda para crear tarjetas de memoria con enlaces de seguimiento de fuentes. Cada tarjeta puede conservar metadatos de ubicación para que puedas volver al pasaje original.","Explora y gestiona todoWeavecartas y mazos en vista de tabla, vista kanban y vista de tarjeta de cuadrícula."],listGroups:[{heading:"Capacidades principales",items:["Extracto de tarjeta: cree tarjetas de memoria a partir de párrafos o selecciones enMarkdown, PDF, elEPUBlector,Canvasy otras fuentes, cada una con un enlace a la fuente.","Gestión de vistas múltiples: explore, filtre y organice todas las cartas y mazos en vistas de tablas, kanban y cuadrículas.","Vista de cuadrícula de la barra lateral: acopla la vista de tarjeta de cuadrícula enObsidianbarra lateral para filtrar tarjetas por las actualmente activasMarkdownarchivo; También admite la creación de tarjetas AI a partir del documento activo, el análisis y la importación de tarjetas.","Banco de preguntas y práctica: analizar el banco de preguntasMarkdownarchivos, importar preguntas e iniciar pruebas de ejercicio; Incluye libro de errores y estadísticas de exámenes.","Repetición espaciada: programación FSRS, sesiones de estudio, estadísticas de progreso y gestión de mazos.","y mas"]}]},{title:"WeaveLectura incremental",paragraphs:["Para cuando ahorra mucho pero nunca lee muchos libros en profundidad: convierta el material disperso deMarkdown, selecciones de PDF,Canvas, páginas web yEPUBcapítulos en una cola de puntos de lectura programable, reanudable y vinculada a la fuente, avanzando a través de un calendario en lugar de solo fuerza de voluntad."],listGroups:[{heading:"Capacidades principales",items:["Puntos y temas de lectura (IRDeck): cree puntos a partir de selecciones de documentos, bloquee enlaces, selecciones de lectores y más; organícelos en temas .irdeck.","Calendario de lectura incremental: vea puntos pendientes, programados y vencidos por fecha y planifique tareas de lectura diarias.","Programación y resumen: límites diarios, presupuestos de tiempo, lecturas intercaladas y retorno con un clic a la posición de origen exacta.","Retroceso al origen: los puntos de lectura mantienen los metadatos del origen para que pueda regresar aMarkdown, PDF,EPUBy otros orígenes.","Integración del lector: agregue capítulos del TOC de este lector a la lectura incremental; crear puntos de lectura conEPUBObtenga enlaces profundos del texto seleccionado.","y mas"]}]},{title:"Como combinarlos",paragraphs:["Los tres complementos tienen funciones separadas y se pueden combinar según sea necesario. Configuraciones comunes:"],listGroups:[{items:["Leer y extraer sólo enObsidian: Weave EPUBEl lector solo es suficiente.","Revisa y haz tarjetas después de leer:EPUBLector +WeaveComplemento principal: llene la ventana de la tarjeta a partir de extractos o utilice AI dividida en tarjeta.","Pase libros largos o múltiples:EPUBLector +WeaveLectura incremental: programe capítulos en el calendario y realice enlaces profundos en los días de entrega.","Bucle completo (leer → capturar → programar → revisar): instale los tres: extracto mientras lee, revise con tarjetas, ponga en cola capítulos y pasajes para una lectura incremental."]}]}],Qye=[{title:"EPUBmotor de análisis y lectura",paragraphs:["EPUBleer es ahorafully basado en elfoliate-jsmotor, mientras que las posiciones de lectura históricas y los datos existentes se migran de la forma más compatible posible."]},{title:"Enlaces y conocimientoedgecaptura",paragraphs:["el precisoEPUBEl flujo de trabajo de enlace y retroceso se inspiró en las excelentes ideas detrásObsidian PDF++y combinado conObsidianvínculos de retroceso y capacidades gráficas."]},{title:"lectura yCanvasintegración",paragraphs:["La integración entre elEPUBlector yObsidian Canvasfue inspirado porMarginNote-Estilo de lectura y flujos de trabajo de mapas mentales mientras continúa evolucionando dentroObsidianEl sistema de archivos nativo de."]},{title:"Inspiración en modo párrafo",paragraphs:["El modo de lectura de párrafos se inspiró en la experiencia del modo de párrafos en elReadestaplicación de lectura, luego adaptada para adaptarse a la ubicación, el extracto y los flujos de trabajo de notas al pie de este lector."]},{title:"Referencia de interacción de la barra de herramientas",paragraphs:["La interacción de la barra de herramientas de selección de texto se inspira en la experiencia de la barra de herramientas de lectura enWeRead."]},{title:"Compatibilidad del complemento de diccionario",paragraphs:["Gracias a la comunidad construidaObsidiancomplemento `obsdian-fingertip-translation`. Originalmente trajo soporte de búsqueda de palabras en el editor aObsidian Markdowneditar y ahora también puede trabajar dentro de esteEPUBlector después del manejo de compatibilidad.","El lector en sí no incluye un diccionario. Ese complemento externo proporciona explicaciones del diccionario y ventanas emergentes relacionadas."],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],ewe={basics:Gye,highlight:Zye,workflow:Xye,tools:Yye,family:Jye,credits:Qye},twe=[{title:"فتح واستعادة",paragraphs:["ضع ملف الكتاب في ملفكObsidian vaultوانقر عليه لفتح. يقوم القارئ تلقائيًا بحفظ واستعادة تقدم القراءة وتفضيلات الطباعة وحالة القراءة الحالية.","التنسيقات المدعومة حاليًا هي .epub، و.mobi، و.azw3، و.fb2، و.fbz، و.txt، و.cbz. في الممارسة العملية،EPUB, FB2/FBZ، وTXTهي أفضل للتصدير المنظم، في حينCBZهو أكثر توجها نحو الصورة."]},{title:"الشريط الجانبي ورف الكتب",paragraphs:["يدعم القارئ كلاً من الشريط الجانبي المحلي وعرض رف الكتب الشامل حتى تتمكن من التبديل بين الكتب وجدول المحتويات والتعليقات التوضيحية داخل نفس مساحة عمل تدوين الملاحظات."],listGroups:[{items:["TOC:القفز بسرعة حسب الفصل.","Notes:قم بمراجعة النقاط البارزة والأفكار والمحتوى ذي الصلة الذي تمت مزامنته للكتاب الحالي.","Bookmarks:إدارة الإشارات المرجعية للصفحة الحالية.","My Bookshelf: تصفح ملفات الكتب في المخزن ثم ارجع من العرض الفرعي لرف الكتب إلى الشريط الجانبي للكتاب الحالي."]}]},{title:"أوضاع القراءة والتخطيط",listGroups:[{heading:"تدفق القراءة",items:["Paged mode: الأفضل للقراءة الخطية وقلب صفحات لوحة المفاتيح.","Scrolled mode: الأفضل للمقاطع الأطول، والرحلات ذهابًا وإيابًا في الحواشي السفلية، والبحث السريع في السياق القريب."]},{heading:"تخطيط الصفحة",items:["صفحة واحدة: التخطيط الافتراضي لمعظم المواقف.","عمود مزدوج: أقرب إلى ملمس الكتاب المفتوح ويتحول تلقائيًا إلى شاشة عرض أوسع."]},{heading:"وضع العرض",items:["standard: standardعرض القراءة للقراءة الغامرة الطويلة.","full: تخطيط أوسع يحافظ على هوامش مريحة على الشاشات الأكبر حجمًا.","edge: صحيحedge-ل-edgeالوضع الذي يستخدم أكبر قدر ممكن من عرض المضيف."]}]},{title:"إعدادات العرض والمساعدين",paragraphs:["تغطي إعدادات القارئ أكثر من العرض. وهي تتضمن أيضًا الطباعة والحواشي وعرض المعلومات العليا حتى تتمكن من ضبط التجربة حسب نوع الكتاب."],listGroups:[{items:["تقوم لوحة الطباعة بضبط ارتفاع الخط وتباعد الأحرف وهوامش الصفحة، ويمكنها استعادة الإعدادات الافتراضية.","Scrolled modeيمكن تبديل أزرار الصفحة اليمنى بشكل مستقل.","يمكن أن تقوم نقرات علامة الحواشي السفلية بالتبديل بين إظهار الحواشي السفلية والانتقال مباشرة إلى الحاشية السفلية."]}]}],rwe=[{title:"أنماط التعليقات التوضيحية",paragraphs:["يؤدي تحديد النص إلى فتح شريط الأدوات ويدعم تمييز الألوان بالإضافة إلى أنماط التعليقات التوضيحية المضمنة المتعددة. يتم حفظ جميع بيانات اللون والنمط والموقع واستعادتها معًا."],colors:[{tone:"yellow",label:"أصفر",description:"وضع العلامات العامة"},{tone:"green",label:"أخضر",description:"المحتوى الرئيسي"},{tone:"blue",label:"أزرق",description:"ملاحظات التفكير"},{tone:"red",label:"أحمر",description:"الأسئلة والشكوك"},{tone:"purple",label:"أرجواني",description:"الجمعيات الموسعة"}],listGroups:[{heading:"الأنماط",items:["تسليط الضوء على: أفضل لstandardمقتطفات.","تسطير: يحافظ على خلفية الصفحة مع التركيز على الجمل الرئيسية.","يتوسطه خط: مفيد لتجاهل المحتوى أو مراجعته أو إخفائه.","التسطير المتموج: مفيد للمشاكل أو الشكوك أو المقاطع التي تحتاج إلى تمريرة أخرى."]}]},{title:"فقاعات الفكر والحواشي السفلية",paragraphs:["فقاعات الفكر في النص هي إشارات إضافية. وهي لا تحل محل أو تضعف التمييز أو التسطير أو يتوسطه خط أو التسطير المموج نفسه.","طالما أن المقتطف يحتوي على `---div---` الفاصل، يُظهر القارئ فقاعة فكرية بجانب التمييز. يمكنك تحريره من الفقاعة أو من الإجراء الفكري لشريط الأدوات.","يمكن تكوين نقرات علامة الحواشي السفلية لإظهار معاينة منبثقة أو الانتقال مباشرة إلى موقع الحاشية السفلية."]},{title:"استعادة ومزامنة",listGroups:[{items:["تظهر النقاط المميزة والأنماط والأفكار مرة أخرى تلقائيًا عند إعادة فتح الكتاب نفسه.","مصادر البيانات تدعم باستمرارMarkdown, Canvasوبيانات البطاقة بدلاً من الاعتماد على قاعدة بيانات الصندوق الأسود المنفصلة.","روابط المصدر هي السجل الرسمي لاستعادة المقتطفات وتحديد موقعها. طالما ظل الرابط صالحًا، يمكنك إعادة كتابة نص المقتطف بحرية.","عندما يتغير ملف ملاحظة، يقوم القارئ بإعادة تحميل التمييزات ذات الصلة بحيث يظل عرض الكتاب وعرض الملاحظة متزامنين."]}]}],iwe=[{title:"كيف تعمل المقتطفات الآلية",paragraphs:["في القارئ، يظهر تحديد النص والتمييز لفترة وجيزة فقط - ولا يحفظ بيانات المقتطفات. للاحتفاظ بالمقتطفات بشكل دائم، قم بإنشاء أو اختيار ملفMarkdownملحوظة،Canvas، أوWeaveالوجهة، واختر مكان الإدراج، وسيقوم القارئ بالكتابة إلى هذا الموقع تلقائيًا.","يتوقع العديد من المستخدمين أن يتم التمييز بمفرده لحفظ الملاحظة. في الممارسة العملية، يجب عليك إنشاء ملف هدف أو اختياره أولاً؛ عندها فقط يتم كتابة المقتطف في قبو الخاص بك للتخزين على المدى الطويل."],listGroups:[{heading:"حفظ وتجميع مقتطفات",items:["مقتطفات القراءة تعيش فيMarkdown, Canvas، وWeaveبطاقات؛ ويجمعها القارئ في مكان واحد.","يمكنك تحرير النص الأساسي للبطاقة بحرية، ولكن لا تقم بتغيير روابط المصدر - مما يؤدي إلى قطع الموقع وإعادة العرض.","للحفظ بشكل دائم، استخدم شريط أدوات التحديد لاختيار هدف: إنشاء أو اختيارMarkdown، ربطCanvas، أو مقتطف منهWeave."]}]},{title:"الوضع التلقائي وشريط أدوات التحديد",paragraphs:["يحدد الوضع التلقائي مسار الإخراج الافتراضي بعد تحديد النص: يميل وضع إيقاف التشغيل نحو النسخ، بينما يميل وضع التشغيل نحو الكتابة مباشرة في سير عملك الحالي."],listGroups:[{items:["إيقاف الوضع التلقائي: انسخ إلى الحافظة للاقتباس المؤقت.","تشغيل الوضع التلقائي: أفضل للكتابة مباشرة في سير العمل الحالي والمشاركة فيه أيضًاCanvas- التدفقات المرتبطة","يدعم شريط أدوات التحديد النسخ أو الإدراج والبحث وإنشاء البطاقة ونقاط القراءة وإجراءات الذكاء الاصطناعي والمزيد."]}]},{title:"تنسيق المقتطف وروابط المصدر",paragraphs:["يحاول القارئ إرفاق بيانات الموقع الدقيقة بمقتطفات حتى تتمكن من الرجوع من الملاحظات إلى المقطع المصدر.","إذا كان المقتطف يتضمن فكرة، فضعه بعد `---div---` يوصى بالفاصل حتى تظهر فقاعة الأفكار في النص تلقائيًا."],code:`> [!EPUB|yellow] [[book.epub#^chapter-anchor|Chapter 1]]
> Excerpt body
> ---div---
> Thought body`},{title:"الإشارات المرجعية ومواقف القراءة",listGroups:[{items:["الإشارة المرجعية للصفحة الحالية: اترك نقطة عودة سريعة للصفحة الحالية.","نقطة القراءة الأخيرة: احفظ موقع القراءة الأخير الذي تريد الاحتفاظ به على المدى الطويل.","النقطة المرجعية للقراءة: قم بتسجيل نقطة ارتساء القراءة الرئيسية حتى تتمكن من العودة بعد التفرع.","نقطة استئناف القراءة التزايدية: العمل مع القراءة التزايدية كنقطة الدخول التالية للمعالجة."]}]}],awe=[{title:"تصدير إلىMarkdown",paragraphs:["استخدم قائمة عرض القارئ كنقطة إدخال للتصدير عندما تريد تحويل مخرجات القراءة إلى ملاحظات مخزنة طويلة المدى."],listGroups:[{items:["تصدير الفصل الحالي: تحويل الفصل الحالي إلىMarkdownوالاحتفاظ بالصور كماObsidian-المرفقات الودية كلما أمكن ذلك.","تصدير أبرز الكتاب: تنظيم التعليقات التوضيحية والمقتطفات من الكتاب الحالي لتحسينها لاحقًا."]}]},{title:"لقطات الشاشة وCanvasاندماج",listGroups:[{heading:"لقطات الشاشة",items:["في وضع لقطة الشاشة، يمكنك سحب منطقة الالتقاط فوق إطار عرض القراءة.","وضع الصورة: احفظ كملف صورة وأدخله مباشرة عند تشغيل الوضع التلقائي.","وضع التضمين: استخراج النص عندما يكون ذلك ممكنًا وإنشاء مرجع مدرك للموقع؛ عند إيقاف تشغيل الوضع التلقائي فإنه يفضل نسخ النتيجة."]},{heading:"Canvas",items:["يمكنك إنشاء جديدCanvasخريطة للكتاب الحالي أو ربط الكتاب الحاليCanvas.","بعد الربط، يمكنك فتحه أو الاستمرار في تحريره أو فصله، وهو ما يعمل بشكل جيد مع خرائط الفصول وأشجار الأسئلة ومسارات القراءة."]}]},{title:"نقاط الدخول والاختصارات المشتركة",shortcuts:[{keys:["←","→"],description:"عندما يكون الوضع المقسم إلى صفحات نشطًا وEPUBتم التركيز على العرض، وانتقل إلى الصفحة السابقة أو التالية (لا يستخدم وضع التمرير مفاتيح الأسهم)."},{keys:["←","→","PageUp","PageDown"],description:"في وضع قراءة الفقرة، تحرك داخل الفقرات أو عبرها عندما يتم التركيز على لوحة الفقرة."},{keys:["Esc"],description:"قم بإغلاق البرنامج التعليمي، أو قم بتجاهل تراكب القارئ الذي يتم التركيز عليه حاليًا."}],buttons:[{icon:"list",label:"الشريط الجانبي",description:"قم بالتبديل بين جدول المحتويات والملاحظات والإشارات المرجعية ونقاط الدخول المتعلقة بأرفف الكتب."},{icon:"a-large-small",label:"الطباعة",description:"اضبط ارتفاع السطر وتباعد الأحرف وهوامش الصفحة ومعلمات القراءة الأخرى."},{icon:"arrow-up-down",label:"تدفق القراءة",description:"التبديل بين القراءة المقسمة إلى صفحات والقراءة التمريرية."},{icon:"scroll-text",label:"تخطيط الصفحة",description:"التبديل بين تخطيطات الصفحة الواحدة والأعمدة المزدوجة."},{icon:"bookmark",label:"المرجعية الحالية",description:"سجل موضع الصفحة الحالية."},{icon:"flag",label:"نقطة مرجعية",description:"حفظ أو تحديث مرساة مرجع القراءة."},{icon:"layout-dashboard",label:"Canvasرسم خريطة",description:"إنشاء خريطة القراءة أو ربطها أو إدارتها."},{icon:"camera",label:"أداة لقطة الشاشة",description:"أدخل سير عمل لقطة الشاشة."},{icon:"zap",label:"الوضع التلقائي",description:"التبديل بين إخراج النسخ أولاً والإدراج التلقائي."},{icon:"circle-help",label:"درس تعليمي",description:"افتح هذا البرنامج التعليمي مرة أخرى."}]}],nwe=[{title:"ما هوWeave",paragraphs:["Weaveهي عائلة منObsidianالمكونات الإضافية المبنية على التعلم طويل المدى: القراءة ← الالتقاط ← الجدولة ← المراجعة.","Weave EPUBيتعامل القارئ (هذا البرنامج المساعد) مع القراءة والمقتطفات داخل القبو؛ الWeaveيتعامل البرنامج المساعد الرئيسي مع مجموعات الذاكرة، وبنوك الأسئلة، وإنشاء البطاقات الذكية؛Weaveتتعامل القراءة التزايدية مع قوائم انتظار نقاط القراءة وجدولة التقويم."],listGroups:[{heading:"كيف تقسم المكونات الإضافية الثلاثة العمل",items:["Weave EPUBالقارئ: قراءة الكتب فيObsidian، وإدارة النقاط البارزة والمقتطفات، والتواصل مع الملاحظات،Canvas، والطوابق.","Weaveالبرنامج الإضافي الرئيسي: إنشاء بطاقات ذاكرة بروابط مصدر من أي فقرة في أي ملف قبو، وإدارتها ومراجعتها في طرق عرض الجدول وكانبان والشبكة.",'Weaveالقراءة المتزايدة: قم بتنظيم مواد "القراءة لاحقًا" في قوائم انتظار نقطة القراءة وقم بتقديم كتب وفصول متعددة من خلال الموضوعات والتقويم الشهري.']}]},{title:"Weave EPUBالقارئ (هذا البرنامج المساعد)",paragraphs:["يصنعObsidianأكثر من مجرد أرشيف للملاحظات - مكان تقرأ فيه بالفعل: مفتوحEPUB, TXTوالكتب الأخرى الموجودة في خزنتك، واقتطف مقتطفات منها أثناء تنقلك، واحتفظ بالمقاطع المرتبطة بملاحظاتك من خلال الروابط العميقة والعرض الداخلي."],listGroups:[{heading:"القدرات الأساسية",items:["رف الكتب والقراءة: مكتبة متعددة التنسيقات، التنقل في جدول المحتويات، الأوضاع المقسمة إلى صفحات/التمرير، الطباعة والموضوعات، التقدم والإشارات المرجعية.","المقتطفات والإبرازات: شريط أدوات التحديد، وخمسة ألوان مميزة وأنماط علامات خطية، وفقاعات فكرية، والتقاط تلقائي أو يدويMarkdown, Canvas، أوWeaveالطوابق.","التتبع وإعادة العرض: تحتفظ المقتطفات ببيانات الموقع؛ يسلط الضوء على التحديث عند تغيير الملاحظات؛ القفز من مكان مميز إلى الملاحظة المصدر،Canvas، أو سطح السفينة.","سير العمل الممتد: تصدير الفصل، لقطات الشاشة،Canvasالربط، وضع قراءة الفقرة؛ إنشاء البطاقة والذكاء الاصطناعي عبرWeaveالبرنامج المساعد الرئيسي. جدولة الفصل ونقاط القراءة عن طريق القراءة المتزايدة.","وأكثر"]}]},{title:"Weaveالبرنامج المساعد الرئيسي",paragraphs:["WeaveهوObsidian- المعرفة المبنية علىedgeنظام البطاقة: قم باقتباس أي فقرة من أي ملف في قبو الخاص بك لإنشاء بطاقات ذاكرة مع روابط تتبع المصدر. يمكن لكل بطاقة الاحتفاظ بالبيانات الوصفية للموقع حتى تتمكن من العودة إلى المقطع الأصلي.","تصفح وإدارة الكلWeaveالبطاقات والطوابق في عرض الجدول، وعرض كانبان، وعرض بطاقة الشبكة."],listGroups:[{heading:"القدرات الأساسية",items:["مقتطف من البطاقة: قم بإنشاء بطاقات ذاكرة من الفقرات أو التحديدات الموجودة فيهاMarkdown، بي دي إف،EPUBقارئ،Canvas، وغيرها من المصادر، كل منها مع رابط العودة إلى المصدر.","إدارة طرق العرض المتعددة: تصفح جميع البطاقات والطوابق وتصفيتها وتنظيمها في طرق عرض الجدول وكانبان وبطاقة الشبكة.","عرض شبكة الشريط الجانبي: قم بإرساء عرض بطاقة الشبكةObsidianالشريط الجانبي لتصفية البطاقات حسب النشطة حاليًاMarkdownملف؛ يدعم أيضًا إنشاء بطاقة AI من المستند النشط وتحليل البطاقات واستيرادها.","بنك الأسئلة والممارسة: تحليل بنك الأسئلةMarkdownالملفات، واستيراد الأسئلة، وبدء اختبارات التمرين؛ يتضمن كتاب الأخطاء وإحصائيات الامتحان.","التكرار المتباعد: جدولة FSRS، وجلسات الدراسة، وإحصائيات التقدم، وإدارة سطح السفينة.","وأكثر"]}]},{title:"Weaveالقراءة التزايدية",paragraphs:["لأنه عندما تقوم بحفظ الكثير ولكنك لا تقرأ بعمق في العديد من الكتب: قم بتحويل المواد المتناثرة منMarkdown، تحديدات PDF،Canvasوصفحات الويب وEPUBالفصول في قائمة انتظار نقطة قراءة قابلة للجدولة والاستئناف ومرتبطة بالمصدر - يتم تقديمها من خلال التقويم بدلاً من قوة الإرادة وحدها."],listGroups:[{heading:"القدرات الأساسية",items:["نقاط القراءة والموضوعات (IRDeck): إنشاء نقاط من تحديدات المستندات، وحظر الروابط، واختيارات القارئ، والمزيد؛ قم بتنظيمها في موضوعات .irdeck.","تقويم القراءة التزايدي: راجع النقاط المعلقة والمجدولة والمتأخرة حسب التاريخ وتخطيط مهام القراءة اليومية.","الجدولة والاستئناف: الحدود اليومية، والميزانيات الزمنية، والقراءة المتداخلة، والعودة بنقرة واحدة إلى موضع المصدر المحدد.","الرجوع إلى المصدر: تحتفظ نقاط القراءة بالبيانات الوصفية للمصدر حتى تتمكن من العودة إليهاMarkdown، بي دي إف،EPUB، وغير ذلك من الأصول.","تكامل القارئ: إضافة فصول من جدول المحتويات لهذا القارئ إلى القراءة المتزايدة؛ إنشاء نقاط القراءة معEPUBمصدر الروابط العميقة من النص المحدد.","وأكثر"]}]},{title:"كيفية الجمع بينهما",paragraphs:["للمكونات الإضافية الثلاثة أدوار منفصلة ويمكن مزجها حسب الحاجة. الإعدادات الشائعة:"],listGroups:[{items:["قراءة ومقتطفات فقط فيObsidian: Weave EPUBالقارئ وحده يكفي.","مراجعة وصنع البطاقات بعد القراءة:EPUBالقارئ +Weaveالمكون الإضافي الرئيسي — املأ نافذة البطاقة من المقتطفات أو استخدم تقنية التقسيم إلى بطاقة بتقنية الذكاء الاصطناعي.","وتيرة الكتب المتعددة أو الطويلة:EPUBالقارئ +Weaveالقراءة المتزايدة - قم بجدولة الفصول في التقويم والارتباط العميق مرة أخرى في الأيام المحددة.","حلقة كاملة (قراءة ← التقاط ← جدولة ← مراجعة): قم بتثبيت المقتطفات الثلاثة جميعها أثناء القراءة، ومراجعتها باستخدام البطاقات، ووضع الفصول والمقاطع في قائمة الانتظار للقراءة المتزايدة."]}]}],owe=[{title:"EPUBمحرك التحليل والقراءة",paragraphs:["EPUBالقراءة الآنfullي على أساسfoliate-jsالمحرك، بينما يتم ترحيل مواضع القراءة التاريخية والبيانات الموجودة بشكل متوافق قدر الإمكان."]},{title:"الروابط والمعرفةedgeيأسر",paragraphs:["الدقيقEPUBتم استلهام سير عمل الارتباط والقفز الخلفي من الأفكار الممتازة التي تكمن خلفهاObsidian PDF++وجنبا إلى جنب معObsidianالروابط الخلفية وقدرات الرسم البياني."]},{title:"القراءة وCanvasاندماج",paragraphs:["التكامل بينEPUBالقارئ وObsidian Canvasكان مستوحى منMarginNote-أسلوب القراءة وسير عمل الخريطة الذهنية مع الاستمرار في التطور في الداخلObsidianنظام الملفات الأصلي."]},{title:"إلهام وضع الفقرة",paragraphs:["تم استلهام وضع قراءة الفقرة من تجربة وضع الفقرة فيReadestتطبيق القراءة، ثم تم تكييفه ليناسب موقع هذا القارئ ومقتطفاته وسير عمل الحواشي السفلية."]},{title:"مرجع تفاعل شريط الأدوات",paragraphs:["يستلهم تفاعل شريط أدوات تحديد النص من تجربة شريط أدوات القراءة فيWeRead."]},{title:"توافق البرنامج المساعد للقاموس",paragraphs:["بفضل المجتمع الذي بناهObsidianالبرنامج المساعد `obsdian-fingertip-translation`. لقد جلب في الأصل دعم البحث عن الكلمات داخل المحرر إلىObsidian Markdownالتحرير ويمكنه الآن أيضًا العمل داخل هذاEPUBالقارئ بعد معالجة التوافق.","القارئ نفسه لا يجمع القاموس. يتم توفير تفسيرات القاموس والنوافذ المنبثقة ذات الصلة بواسطة هذا البرنامج المساعد الخارجي."],links:[{label:"obsdian-fingertip-translation",url:"https://github.com/huangchen-byte/obsdian-fingertip-translation"}]}],swe={basics:twe,highlight:rwe,workflow:iwe,tools:awe,family:nwe,credits:owe};function lwe(r){switch(r){case"zh-CN":return"zh-CN";case"zh-TW":return"zh-TW";case"ja-JP":return"ja-JP";case"ko-KR":return"ko-KR";case"ru-RU":return"ru-RU";case"de-DE":return"de-DE";case"es-ES":return"es-ES";case"ar-SA":return"ar-SA";default:return"en-US"}}const cwe={"zh-CN":[{id:"basics",label:"基础阅读"},{id:"highlight",label:"高亮与想法"},{id:"workflow",label:"摘录工作流"},{id:"tools",label:"工具联动"},{id:"family",label:"Weave 系列"},{id:"credits",label:"致谢"}],"zh-TW":[{id:"basics",label:"基礎閱讀"},{id:"highlight",label:"高亮與想法"},{id:"workflow",label:"摘錄工作流"},{id:"tools",label:"工具聯動"},{id:"family",label:"Weave 系列"},{id:"credits",label:"致謝"}],"en-US":[{id:"basics",label:"Basics"},{id:"highlight",label:"Highlights"},{id:"workflow",label:"Workflow"},{id:"tools",label:"Tools"},{id:"family",label:"Weave family"},