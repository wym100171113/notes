:{label:"Covers only",description:"Switch to a pure cover wall."}},premium:{defaultTitle:"Premium feature preview",defaultDescription:"This capability is part of premium features and becomes available after activation.",freeColumnTitle:"Free features",premiumColumnTitle:"Premium features",continueBasicReading:"Continue basic reading",limitedTimeOpenSuffix:" (Limited-time access)",lockedFormatNotice:"{format} reading is a premium feature. Please activate a license to use it",freeFeatures:{basicReading:{title:"Basic EPUB, TXT, and FB2 reading",description:"Open EPUB, TXT, and FB2/FBZ books for free with chapter navigation and table of contents browsing (TXT is split by paragraphs)."},bookmarksAndNavigation:{title:"Bookmarks and reading progress",description:"Use the book data folder, page bookmarks, bookmark list navigation, reading position save/restore, bookshelf progress, and continuous-reading autosave for free."},incrementalReadingEntry:{title:"Incremental reading entry",description:"Add chapters to incremental reading from the table of contents (requires the IR plugin; currently a free entry point)."},typographyAndView:{title:"Typography and views",description:"Adjust layout, typography, and scrolled side page buttons for free."},bookMapDensity:{title:"Book map density bar",description:"See excerpt density across the whole book in the contents sidebar to jump to hot spots quickly."},aiAndTutorial:{title:"AI and tutorial entry",description:"Use text search, the AI panel, and reader tutorial for free."},cardCreation:{title:"Turn excerpts into cards",description:"Fill the memory card creation window with the current selection or excerpt for free."},excerptNotes:{title:"Excerpts and thoughts",description:"Use highlights, thoughts, excerpt timestamps, screenshot tools, and saved image files for free."},styledExcerpts:{title:"Excerpt style marks",description:"Use underline, strikethrough, wavy underline, and related display controls for free."},excerptNotesCardList:{t