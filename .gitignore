# macOS
.DS_Store

# Office / 临时文件
~$*

# Obsidian workspace 状态(UI 布局,自动生成,持续变化)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian 插件缓存
.obsidian/plugins/obsidian-completr/scanned_words.txt

# Obsidian 插件数据(可能含 API 密钥/本地状态,不应入库)
.obsidian/plugins/*/data.json

# Trae IDE 配置与任务规格
.trae/

# 神秘文件夹
神秘文件夹/

# VitePress 站点(生成内容与依赖)
site/node_modules/
site/docs/
site/.vitepress/dist/
site/.vitepress/cache/
site/.vitepress/generated/

# Obsidian 自动生成的 index.md(导航文件, 内容自动重建, 不应入库)
**/index.md

# site 下调试用临时脚本(agent 排错产物)
site/probe-*.mjs
site/verify-*.mjs
site/debug-*.mjs
site/dbg-*.mjs
site/check-*.mjs
site/extra*.mjs
site/audit*.mjs
site/find-*.mjs
site/cdp-*.mjs
site/dark-reorder*.mjs
site/mermaid-lazy.mjs
site/verify-fix.mjs

# Obsidian 插件发布产物(manifest 保留, 二进制不入库)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

